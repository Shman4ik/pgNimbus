<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             x:Class="PgNimbus.App.Views.ShortcutsView"
             x:DataType="vm:ShortcutsViewModel">


    <UserControl.Styles>
        <!-- kbd chip: one bordered key cap per key, TablePlus/VS Code-style -->
        <Style Selector="Border.kbd">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kbd TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.combo">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.what">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Grid.shortcutRow">
            <Setter Property="Margin" Value="10,5" />
        </Style>
    </UserControl.Styles>

    <!-- Every row below is generated from PgNimbus.Core.Commands.CommandCatalog
         (via ShortcutsViewModel), which is also what builds the window's key
         bindings, the command palette and docs/reference/keyboard-shortcuts.md.
         Add a shortcut to the catalog and it shows up here on its own — never
         hand-author a row in this file. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,14">
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutSection">
                    <StackPanel Spacing="4" Margin="0,0,0,14">
                        <TextBlock Classes="sectionHeader" Text="{Binding Title}" Margin="4,0,4,4" />
                        <Border Classes="card" Padding="4">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShortcutRow">
                                        <Grid Classes="shortcutRow" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="what" Text="{Binding Action}" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tokens}"
                                                          HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShortcutToken">
                                                        <Panel>
                                                            <Border Classes="kbd" IsVisible="{Binding IsKey}">
                                                                <TextBlock Text="{Binding Text}" />
                                                            </Border>
                                                            <TextBlock Classes="combo" IsVisible="{Binding !IsKey}"
                                                                       Text="{Binding Text}" />
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
