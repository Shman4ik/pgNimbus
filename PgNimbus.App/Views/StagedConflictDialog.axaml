<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:PgNimbus.App.Views"
        x:Class="PgNimbus.App.Views.StagedConflictDialog"
        Title="pgNimbus — Commit rolled back"
        Width="760" Height="520"
        MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}">

    <Window.Styles>
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0" Name="SummaryText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />

        <SelectableTextBlock Grid.Row="1" Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Column captions, aligned with each row's grid below. -->
        <Grid Grid.Row="2" Name="ColumnHeader" ColumnDefinitions="150,*,*,*" Margin="10,0,10,4" Opacity="0.6">
            <TextBlock Grid.Column="0" FontSize="11" Text="Column" />
            <TextBlock Grid.Column="1" FontSize="11" Text="When you loaded it" />
            <TextBlock Grid.Column="2" FontSize="11" Text="On the server now" />
            <TextBlock Grid.Column="3" FontSize="11" Text="You staged" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="ConflictList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="v:ConflictRowView">
                        <Border Classes="card" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="v:ConflictCellView">
                                            <Grid ColumnDefinitions="150,*,*,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Column}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Before}"
                                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                           ToolTip.Tip="{Binding FullBefore}" />
                                                <!-- The column another session changed is the reason for
                                                     the rollback, so it's the one that gets the colour. -->
                                                <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Current}"
                                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                           ToolTip.Tip="{Binding FullCurrent}"
                                                           Classes.changed="{Binding ChangedElsewhere}" />
                                                <TextBlock Grid.Column="3" FontSize="12" Text="{Binding Proposed}"
                                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FullProposed}"
                                                           Opacity="{Binding HasProposed, Converter={x:Static v:StagedConflictDialog.DimUnlessTrue}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Name="MoreText" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" FontSize="11" Opacity="0.55" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Nothing was committed. Restaging reloads the rows and keeps your values on top of the current ones, for you to review and commit again." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="RestageButton" Classes="accent" Content="Reload and restage" Click="OnRestageClick" />
                <Button Name="UnstageButton" Classes="soft" Content="Unstage these rows" Click="OnUnstageClick" />
                <Button Classes="soft" Content="Close" Click="OnCloseClick" IsCancel="True" />
            </StackPanel>
        </Grid>

    </Grid>

</Window>
