<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             xmlns:views="using:PgNimbus.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="PgNimbus.App.Views.BrowseFilterBar"
             x:DataType="vm:TableBrowseViewModel">
    <!-- Browse mode's filter bar: typed predicates on the browsed table, run on the
         server as the page query's WHERE. Only exists in browse mode (the host
         hides it otherwise), which is what keeps a hand-written query from ever
         being rewritten: there is no filter to apply to one. Hidden until opened
         (Ctrl/Cmd+F in the grid, the palette, a cell's Filter menu), then shown for
         as long as anything is filtering the rows. Enter applies, Escape hands
         focus back to the grid. -->
    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorderBrush}"
            Padding="4,2,4,6" Margin="0,0,0,4">
        <StackPanel Spacing="4">
            <!-- The FK-seeded raw condition, kept as-is and shown as its own line. -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasRawFilter}">
                <TextBlock Grid.Column="0" Text="Condition" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Center" Margin="2,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding FilterText}" FontSize="12"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding FilterText}" />
                <Button Grid.Column="2" Classes="chip" Content="✕" FontSize="10" Width="20" Height="20" Padding="0"
                        Command="{Binding ClearRawFilterCommand}"
                        ToolTip.Tip="Remove this condition"
                        AutomationProperties.Name="Remove condition" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseFilterViewModel">
                        <Grid ColumnDefinitions="170,6,130,6,*,6,Auto" Margin="0,2">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ColumnNames}"
                                      SelectedItem="{Binding Column, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="12"
                                      AutomationProperties.Name="Filter column" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Operators}"
                                      SelectedItem="{Binding Operator, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="12"
                                      AutomationProperties.Name="Comparison">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterOperatorOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Panel Grid.Column="4" IsVisible="{Binding ShowsValue}">
                                <views:ColumnValueEditorView DataContext="{Binding Value}" />
                            </Panel>
                            <Button Grid.Column="6" Classes="chip" Content="✕" FontSize="10" Width="20" Height="20" Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding $parent[views:BrowseFilterBar].((vm:TableBrowseViewModel)DataContext).RemoveFilterCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Remove this filter"
                                    AutomationProperties.Name="Remove filter" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="chip" Content="+ Filter" FontSize="11" Padding="8,2"
                        Command="{Binding AddFilterRowCommand}"
                        ToolTip.Tip="Add another condition (all conditions must match)" />
                <!-- The generated SQL, before it runs: exactly the WHERE that Apply
                     adds to the page query (which then shows whole in the editor). -->
                <SelectableTextBlock Grid.Column="1" Text="{Binding FilterPreviewSql}" Margin="10,0"
                                     FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11.5"
                                     Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="accent" Content="Apply" FontSize="12" Padding="12,3"
                        Command="{Binding ApplyFiltersCommand}"
                        ToolTip.Tip="Run the query with these filters (Enter)" />
                <Button Grid.Column="3" Classes="soft" Content="Clear" FontSize="12" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding ClearFiltersCommand}"
                        ToolTip.Tip="Remove every filter and close the bar" />
            </Grid>

            <TextBlock Text="{Binding FilterError}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppDangerBrush}"
                       IsVisible="{Binding FilterError, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </Border>
</UserControl>
