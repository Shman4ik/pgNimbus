<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             xmlns:views="using:PgNimbus.App.Views"
             x:Class="PgNimbus.App.Views.BrowseFilterBar"
             x:DataType="vm:TableBrowseViewModel">
    <!-- Browse mode's filter chips: one line, only while something filters the rows
         (or the first condition is being written). Each chip is a condition that runs
         on the server as part of the page query's WHERE; clicking one opens its
         editor in a flyout (FilterEditorView), ✕ drops it, "+ Filter" adds one. The
         whole WHERE is the strip's tooltip, and the full statement is in the editor.

         Only exists in browse mode, and only with the "Row details and table
         filters" preference on (the host hides it otherwise) — which is what keeps
         a hand-written query from ever being rewritten: there are no chips to apply
         to one. -->
    <UserControl.Styles>
        <!-- A chip: tinted pill; the label opens the editor, ✕ removes. -->
        <Style Selector="Border.filterchip">
            <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>
        <Style Selector="Border.filterchip.raw">
            <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
        </Style>
        <Style Selector="Border.filterchip Button.label">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="12,0,0,12" />
        </Style>
        <Style Selector="Border.filterchip Button.x">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="9" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorderBrush}"
            Padding="6,3,6,5" Margin="0,0,0,4" Background="Transparent"
            ToolTip.Tip="{Binding WhereSql}">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="Filtered by" FontSize="11" Opacity="0.55"
                       VerticalAlignment="Center" Margin="4,0,10,0" />

            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The FK-seeded condition, verbatim. Not editable as a chip (it's
                     raw SQL), only removable. -->
                <Border Classes="filterchip raw" IsVisible="{Binding HasRawFilter}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FilterText}" FontSize="11.5" MaxWidth="320"
                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Margin="10,0,4,0" ToolTip.Tip="{Binding FilterText}" />
                        <Button Classes="chip x" Content="✕"
                                Command="{Binding ClearRawFilterCommand}"
                                ToolTip.Tip="Remove this condition"
                                AutomationProperties.Name="Remove condition" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BrowseFilterViewModel">
                            <Border Classes="filterchip">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="label" Content="{Binding Summary}"
                                            Click="OnChipClick"
                                            ToolTip.Tip="{Binding PredicateText}"
                                            AutomationProperties.Name="{Binding Summary, StringFormat='Edit condition {0}'}" />
                                    <Button Classes="chip x" Content="✕"
                                            Command="{Binding $parent[views:BrowseFilterBar].((vm:TableBrowseViewModel)DataContext).RemoveFilterCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove this condition"
                                            AutomationProperties.Name="{Binding Summary, StringFormat='Remove condition {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Name="AddButton" Classes="chip" Content="+ Filter" FontSize="12" Padding="8,0"
                        Height="24" Margin="0,2" Opacity="0.8"
                        Click="OnAddClick"
                        ToolTip.Tip="Add a condition; rows must match all of them"
                        AutomationProperties.Name="Add filter condition" />
            </WrapPanel>

            <Button Grid.Column="2" Classes="chip" Content="Clear all" FontSize="11.5" Padding="8,0" Height="24"
                    VerticalAlignment="Center"
                    Command="{Binding ClearFiltersCommand}"
                    ToolTip.Tip="Remove every condition" />
        </Grid>
    </Border>
</UserControl>
