<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PgNimbus.App.ViewModels"
        xmlns:conn="using:PgNimbus.Core.Connections"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:converters="using:PgNimbus.App.Converters"
        xmlns:views="using:PgNimbus.App.Views"
        xmlns:nui="using:Nimbus.Ui.Controls"
        xmlns:sys="using:System"
        x:Class="PgNimbus.App.Views.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="pgNimbus — Connect"
        Width="720" Height="600"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- Outer grid carries no margin so the About overlay's backdrop can reach the
         window edges; the form keeps its own inset. -->
    <Grid>

    <Grid Margin="16" RowDefinitions="*,Auto,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="240,*">

        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Saved Connections" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Grid.Row="1" Classes="card">
                <Grid>
                    <!-- Rows reorder by drag (pointer handlers in code-behind);
                         the new order persists to connections.json on release. -->
                    <ListBox Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             DoubleTapped="OnProfileDoubleTapped" ContextRequested="OnProfilesContextRequested">
                        <ListBox.KeyBindings>
                            <!-- Enter on the focused row connects. The window's default
                                 button would cover this, but ListBox handles Enter
                                 itself on some platforms and would swallow it. -->
                            <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
                        </ListBox.KeyBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                <Separator />
                                <MenuItem Header="Delete…" Click="OnDeleteProfileClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="conn:ConnectionProfile">
                                <StackPanel ToolTip.Tip="{Binding Endpoint}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding AccentColor, Converter={x:Static converters:HexToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- user@host[:port]/database - enough to tell two
                                         profiles on the same server apart without
                                         selecting either one. -->
                                    <TextBlock Text="{Binding Endpoint}" FontSize="11" Opacity="0.7" Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock IsVisible="{Binding HasNoProfiles}" IsHitTestVisible="False"
                               Text="No saved connections yet — fill in the form and press Save to keep one here"
                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.4" FontSize="12"
                               Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="20,0,0,0" RowDefinitions="Auto,*">

        <!-- Paste-anything import: URI / JDBC / Key=Value / libpq / psql command line.
             Parses automatically as you paste/type, and mirrors the fields below
             as a postgres:// URI whenever you edit them by hand. Because of that
             mirroring the box is usually already full, so it behaves like a
             browser address bar - focusing it selects everything (see
             ConnectionDialog.axaml.cs). -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,14,12">
            <TextBox Name="ImportBox" Grid.Column="0" Text="{Binding ImportText}" Margin="0,0,6,0"
                     PlaceholderText="Paste a connection string (postgres://…, jdbc:…, Key=Value;…, psql …)"
                     ToolTip.Tip="Paste a postgres:// URI, JDBC URL, Npgsql Key=Value string, libpq keyword string or psql command line and the fields fill in by themselves">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ImportConnectionStringCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="chip" Padding="7" Click="OnCopyConnectionStringClick"
                    ToolTip.Tip="Copy connection string to clipboard (includes the password)">
                <PathIcon Data="{StaticResource ClipboardIconGeometry}" Width="14" Height="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <!-- Right margin keeps the scrollbar (shown once the SSH section expands) off the field edges -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,14,0">

            <TextBlock Grid.Row="0" Text="Name" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Placeholders, not pre-filled text: the defaults show dim and
                     vanish the moment you type, and a field left blank still
                     connects to the default it names (Effective* on the VM).
                     The Name placeholder tracks host/database as they're typed. -->
                <TextBox Name="NameBox" Grid.Column="0" Text="{Binding Name}" Margin="0,0,6,0"
                         PlaceholderText="{Binding NamePlaceholder}" />
                <!-- The accent color is a per-connection marker, not a field you
                     fill in every time - one swatch button with the palette
                     behind it, rather than a permanent eight-circle row. -->
                <Button Name="AccentButton" Grid.Column="1" Classes="soft" Width="32" Height="32" Padding="0"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Accent color — tints this connection's window so prod and dev are told apart at a glance">
                    <Ellipse Width="14" Height="14"
                             Fill="{Binding AccentColor, Converter={x:Static converters:HexToBrushConverter.Instance}}"
                             Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}" StrokeThickness="1" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding SelectAccentColorCommand}" CommandParameter="{x:Null}"
                                        Click="OnAccentSwatchClick"
                                        Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Background="Transparent" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                        ToolTip.Tip="No accent color" />
                                <ItemsControl ItemsSource="{Binding AccentColorSwatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button Command="{Binding $parent[ItemsControl].((vm:ConnectionDialogViewModel)DataContext).SelectAccentColorCommand}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnAccentSwatchClick"
                                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Background="{Binding Converter={x:Static converters:HexToBrushConverter.Instance}}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                                    ToolTip.Tip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="Host / Port" />
            <Grid Grid.Row="3" ColumnDefinitions="*,80" Margin="0,0,0,8">
                <TextBox Grid.Column="0" Text="{Binding Host}" Margin="0,0,6,0" PlaceholderText="localhost" />
                <NumericUpDown Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False"
                               PlaceholderText="5432" />
            </Grid>

            <TextBlock Grid.Row="4" Text="Database" />
            <TextBox Grid.Row="5" Text="{Binding Database}" Margin="0,0,0,8" PlaceholderText="postgres" />

            <Grid Grid.Row="6" ColumnDefinitions="*,*" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Username" />
                    <TextBox Text="{Binding Username}" PlaceholderText="postgres" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SSL Mode" />
                    <ComboBox ItemsSource="{Binding SslModes}" SelectedItem="{Binding SslMode}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="7" Margin="0,0,0,8">
                <TextBlock Text="Password" />
                <!-- revealPasswordButton = Fluent's built-in eye toggle -->
                <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" />
            </StackPanel>

            <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <ToggleSwitch IsChecked="{Binding UseSshTunnel}" OnContent="" OffContent="" />
                <TextBlock Text="Connect through an SSH tunnel" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="9" IsVisible="{Binding UseSshTunnel}"
                    Classes="card"
                    Padding="10" Margin="0,0,0,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="SSH Host / Port" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,80" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding SshHost}" Margin="0,0,6,0" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SshPort}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="SSH Username" />
                            <TextBox Text="{Binding SshUsername}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Auth Method" />
                            <ComboBox ItemsSource="{Binding SshAuthMethods}" SelectedItem="{Binding SshAuthMethod}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,0,0,8"
                                IsVisible="{Binding SshAuthMethod, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static conn:SshAuthMethod.PrivateKey}}">
                        <TextBlock Text="Private Key Path" />
                        <TextBox Text="{Binding SshPrivateKeyPath}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="SSH Password / Passphrase" />
                        <TextBox Text="{Binding SshPassword}" PasswordChar="•" Classes="revealPasswordButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="10">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="MediumSeaGreen" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
            </StackPanel>

        </Grid>
        </ScrollViewer>
        </Grid>

    </Grid>

    <!-- All action buttons on one row: New (scoped to the saved-connections
         column) on the left, the current form's actions on the right. Delete
         lives in the list's right-click menu — it acts on a saved row, not on
         the form, and a destructive button does not belong next to Connect. -->
    <Grid Grid.Row="1" ColumnDefinitions="240,*" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="soft" Content="New" Command="{Binding NewCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,0,0,0">
            <Button Classes="soft" Content="Test" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsTesting}"
                    ToolTip.Tip="Verify the connection (and SSH tunnel, if enabled) without opening it" />
            <Button Classes="soft" Content="Save" Command="{Binding SaveCommand}" />
            <!-- IsDefault: Enter anywhere in the dialog connects, so a preselected
                 profile needs no click at all. -->
            <Button Classes="accent" Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnecting}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>

    <!-- Thin full-width footer strip, below the buttons like everything else. -->
    <TextBlock Grid.Row="2" Text="{Binding FooterText}" FontSize="10" Opacity="0.4"
               HorizontalAlignment="Center" Margin="0,10,0,0" />

    </Grid>

    <!-- The same About box the shell hosts, with the same sizing. Here because the
         connect form is often the only window open, and macOS's app-menu "About
         pgNimbus" has to land somewhere (see ConnectionDialogViewModel.IsAboutOpen). -->
    <nui:OverlayPanel IsOpen="{Binding IsAboutOpen, Mode=TwoWay}"
                      Title="About" PanelWidth="340" PanelMaxHeight="400">
        <views:AboutView />
    </nui:OverlayPanel>

    </Grid>

</Window>
