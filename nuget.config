<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins every restore to nuget.org, on this machine and on CI. Without a
  nuget.config, a developer machine that has picked up an extra package
  source (a corporate feed, a leftover from another project, one added by an
  installer) restores from whatever sources NuGet.Config accumulates across
  the machine, which is how a dependency-confusion attack finds a package
  named like an internal one on a public feed a build never meant to use.
  packageSourceMapping pins every package id back to nuget.org explicitly, so
  a source added later (machine-wide or user-wide) cannot silently take over
  a package this repo already restores.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
