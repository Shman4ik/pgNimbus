<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-thread timings for the views the 2026-09 UI-thread audit fixed
    (docs/dev/design/ui-thread-audit.md): the real Views on Avalonia's headless
    platform, bound to the screenshot harness's fixture view models, timed as
    they lay out big data. No display, no Postgres. Prints PGNIMBUS_BENCH lines
    that scripts/benchmarks/run-benchmarks.sh charts per release. Dev-only: not
    referenced by the app, ships in no package, never published AOT.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PgNimbus.UiBench</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PgNimbus.App/PgNimbus.App.csproj" />
    <!-- The fixture view models and the app-data isolation, shared with the
         screenshots and the UI tests rather than copied. -->
    <ProjectReference Include="../Screenshot/Screenshot.csproj" />
  </ItemGroup>

</Project>
