<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Latency measurements for the SQL editor's completion path
    (docs/design/sql-editing-experience.md §8, package I), and the quality
    measurements of the second completion audit
    (docs/design/sql-completion-audit-2.md, Audit/README.md). Dev-only: not
    referenced by the app, ships in no package, never published AOT. Run it in
    Release (see the README next to this project).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PgNimbus.CompletionBench</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PgNimbus.App\PgNimbus.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The audit stand: its catalog snapshot, corpus and case lists travel
         with the binaries (and on to PgNimbus.App.Tests, which references this
         project for the typing replay). -->
    <None Update="Audit\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
