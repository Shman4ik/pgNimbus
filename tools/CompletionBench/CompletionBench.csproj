<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Latency measurements for the SQL editor's completion path
    (docs/design/sql-editing-experience.md §8, package I). Dev-only: not
    referenced by the app, ships in no package, never published AOT. Run it in
    Release (see the README next to this project).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PgNimbus.CompletionBench</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PgNimbus.App\PgNimbus.App.csproj" />
  </ItemGroup>

</Project>
