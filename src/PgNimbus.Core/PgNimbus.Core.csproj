<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PgNimbus.Core</RootNamespace>
    <AssemblyName>PgNimbus.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <Authors>Dmitrii Shmanev</Authors>
    <Product>pgNimbus</Product>
    <Description>PostgreSQL engine for pgNimbus: connections, streaming query execution, and pg_catalog schema introspection. No UI dependencies.</Description>
    <Copyright>Copyright (c) 2026 Dmitrii Shmanev</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Shman4ik/pgNimbus</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests reach one seam: AppDataPaths.RootResolverForTests, which
         makes the app data root unavailable for the one test flow that sets it. -->
    <InternalsVisibleTo Include="PgNimbus.Core.Tests" />
  </ItemGroup>

  <!-- Localization (see Localization/Localizer.cs). The English base file is not
       shipped: the generator compiles its text into the Strings accessors. Each
       translation is embedded as it is, in this assembly, under a plain name:
       never compiled to .resources and never a culture-named satellite assembly
       (which InvariantGlobalization and NativeAOT can't take). -->
  <ItemGroup>
    <EmbeddedResource Remove="Localization\Strings.resx" />
    <AdditionalFiles Include="Localization\Strings.resx" />
    <EmbeddedResource Update="Localization\Strings.*.resx"
                      Type="Non-Resx"
                      WithCulture="false"
                      LogicalName="PgNimbus.%(Filename)%(Extension)" />
    <ProjectReference Include="..\PgNimbus.Strings.Generator\PgNimbus.Strings.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

</Project>
