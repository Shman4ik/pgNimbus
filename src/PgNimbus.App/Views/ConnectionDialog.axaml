<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PgNimbus.App.ViewModels"
        xmlns:conn="using:PgNimbus.Core.Connections"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:converters="using:PgNimbus.App.Converters"
        xmlns:views="using:PgNimbus.App.Views"
        xmlns:nui="using:Nimbus.Ui.Controls"
        xmlns:sys="using:System"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="PgNimbus.App.Views.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="pgNimbus — Connect"
        Width="720" Height="600"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- The outer panel carries no margin so the About overlay's backdrop can reach the
         window edges; the form keeps its own inset. Named because
         NimbusWindowChrome hangs the maximized window's OffScreenMargin on it. -->
    <Panel Name="RootLayout">

    <!-- Bar and block only. The About overlay is kept out of this grid: spanning
         its rows, its window-high desired size was spread over them and pushed
         the capped row past its MaxHeight. -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <!-- The block's row: 760 plus FormLayout's 16px margins at most. A star row
             held at its MaxHeight leaves the rest of the window empty below it; a
             Top-aligned block would have shrunk to its content, the list with it. -->
        <RowDefinition Height="*" MaxHeight="792" />
    </Grid.RowDefinitions>

    <!-- The one bar of chrome, as in the main window (NimbusWindowChrome,
         DESIGN.md rule 9): no icon and no "pgNimbus - Connect" caption over the
         form, and the caption buttons are the same drawn ones. It carries the
         list's heading, over the list. The TitleBar role gives it drag,
         double-click, the window menu and Snap. Padding comes from the chrome,
         which adds the caption-button reserve on top of 16. -->
    <Border Name="ConnectBar" Grid.Row="0" Height="40" Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar"
            BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorderBrush}">
        <TextBlock Name="BarHeading" Text="Saved connections" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Border>

    <!-- The list and the form are one block, capped at 1000 x 760, centred
         across (a Stretch element past its MaxWidth is centred, not
         left-aligned) and kept under the bar. The window itself stops at that
         size and can't be maximized (ConnectionDialog.MaxFormWidth), so the cap
         only matters where a window manager ignores size hints. The bar's
         "Saved connections" heading follows the block's left edge
         (AlignBarHeading in code-behind), so it stays over the list; it can't
         follow it down, which is why the block is never centred vertically. -->
    <Grid Name="FormLayout" Grid.Row="1" Margin="16" MaxWidth="1000"
          RowDefinitions="*,Auto,Auto" ColumnDefinitions="240,*">

    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="240,*" IsEnabled="{Binding CredentialsReady}">

        <Grid Grid.Column="0">
            <Border Classes="card">
                <Grid>
                    <!-- Rows reorder by drag (pointer handlers in code-behind);
                         the new order persists to connections.json on release. -->
                    <ListBox Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             DoubleTapped="OnProfileDoubleTapped" ContextRequested="OnProfilesContextRequested">
                        <ListBox.KeyBindings>
                            <!-- Enter on the focused row connects. The window's default
                                 button would cover this, but ListBox handles Enter
                                 itself on some platforms and would swallow it. -->
                            <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
                        </ListBox.KeyBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                <Separator />
                                <MenuItem Header="Delete…" Click="OnDeleteProfileClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="conn:ConnectionProfile">
                                <StackPanel ToolTip.Tip="{Binding Endpoint}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding AccentColor, Converter={x:Static converters:HexToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <PathIcon Data="{StaticResource LockIconGeometry}" Width="10" Height="10" Opacity="0.6"
                                                  VerticalAlignment="Center" IsVisible="{Binding ReadOnly}"
                                                  ToolTip.Tip="Read-only session" />
                                    </StackPanel>
                                    <!-- user@host[:port]/database - enough to tell two
                                         profiles on the same server apart without
                                         selecting either one. -->
                                    <TextBlock Text="{Binding Endpoint}" FontSize="11" Opacity="0.7" Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock IsVisible="{Binding HasNoProfiles}" IsHitTestVisible="False"
                               Text="No saved connections yet — fill in the form and it's kept here as you type"
                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" FontSize="12"
                               Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="20,0,0,0" RowDefinitions="Auto,*">

        <!-- Paste-anything import: URI / JDBC / Key=Value / libpq / psql command line.
             Parses automatically as you paste/type, and mirrors the fields below
             as a postgres:// URI whenever you edit them by hand. Because of that
             mirroring the box is usually already full, so it behaves like a
             browser address bar - focusing it selects everything (see
             ConnectionDialog.axaml.cs). -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,14,12">
            <TextBox Name="ImportBox" Grid.Column="0" Text="{Binding ImportText}" Margin="0,0,6,0"
                     PlaceholderText="Paste a connection string (postgres://…, jdbc:…, Key=Value;…, psql …)"
                     ToolTip.Tip="Paste a postgres:// URI, JDBC URL, Npgsql Key=Value string, libpq keyword string or psql command line and the fields fill in by themselves">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ImportConnectionStringCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <!-- The click copies without the password (security audit 2026-09, finding 18:
                 clipboard history keeps what is copied). The copy with it is the right-click
                 menu's second item, marked for exclusion from history and cleared after 30 s
                 (Platform/SecretClipboard). No second button: UI rule 1. -->
            <Button Name="CopyConnectionStringButton" Grid.Column="1" Classes="chip" Padding="7" Click="OnCopyConnectionStringClick"
                    ToolTip.Tip="Copy the connection string without the password. Right-click to copy it with the password.">
                <PathIcon Data="{StaticResource ClipboardIconGeometry}" Width="14" Height="14" />
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="CopyWithoutPasswordMenuItem" Header="Copy Without Password" Click="OnCopyConnectionStringClick" />
                        <MenuItem Name="CopyWithPasswordMenuItem" Header="Copy With Password" Click="OnCopyConnectionStringWithPasswordClick"
                                  ToolTip.Tip="Includes the password. Kept out of clipboard history where the system allows it, and cleared from the clipboard after 30 seconds." />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <!-- Right margin keeps the scrollbar (shown once the SSH section expands) off the field edges -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,14,0">

            <TextBlock Grid.Row="0" Text="Name" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Placeholders, not pre-filled text: the defaults show dim and
                     vanish the moment you type, and a field left blank still
                     connects to the default it names (Effective* on the VM).
                     The Name placeholder tracks host/database as they're typed. -->
                <TextBox Name="NameBox" Grid.Column="0" Text="{Binding Name}" Margin="0,0,6,0"
                         PlaceholderText="{Binding NamePlaceholder}" />
                <!-- The accent color is a per-connection marker, not a field you
                     fill in every time - one swatch button with the palette
                     behind it, rather than a permanent eight-circle row. -->
                <Button Name="AccentButton" Grid.Column="1" Classes="soft" Width="32" Height="32" Padding="0"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Accent color — tints this connection's window so prod and dev are told apart at a glance">
                    <Ellipse Width="14" Height="14"
                             Fill="{Binding AccentColor, Converter={x:Static converters:HexToBrushConverter.Instance}}"
                             Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}" StrokeThickness="1" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding SelectAccentColorCommand}" CommandParameter="{x:Null}"
                                        Click="OnAccentSwatchClick"
                                        Width="24" Height="24" Padding="0" CornerRadius="12"
                                        Background="Transparent" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                        ToolTip.Tip="No accent color" />
                                <ItemsControl ItemsSource="{Binding AccentColorSwatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button Command="{Binding $parent[ItemsControl].((vm:ConnectionDialogViewModel)DataContext).SelectAccentColorCommand}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnAccentSwatchClick"
                                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                                    Background="{Binding Converter={x:Static converters:HexToBrushConverter.Instance}}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                                    ToolTip.Tip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="Host / Port" />
            <Grid Grid.Row="3" ColumnDefinitions="*,80" Margin="0,0,0,8">
                <TextBox Grid.Column="0" Text="{Binding Host}" Margin="0,0,6,0" PlaceholderText="localhost" />
                <NumericUpDown Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False"
                               PlaceholderText="5432" />
            </Grid>

            <TextBlock Grid.Row="4" Text="Database" />
            <TextBox Grid.Row="5" Text="{Binding Database}" Margin="0,0,0,8" PlaceholderText="postgres" />

            <Grid Grid.Row="6" ColumnDefinitions="*,*" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Username" />
                    <TextBox Text="{Binding Username}" PlaceholderText="postgres" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SSL Mode" />
                    <!-- Each mode says what it checks (audit 2026-09, finding 9): the
                         bare enum names made Require read as the safe choice. The
                         closed box shows the name alone, one line beside Username. -->
                    <ComboBox Name="SslModeCombo" ItemsSource="{Binding SslModes}" SelectedItem="{Binding SslMode}" HorizontalAlignment="Stretch">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="conn:SslMode">
                                <TextBlock Text="{Binding Converter={x:Static converters:SslModeText.Label}}" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="conn:SslMode">
                                <StackPanel MaxWidth="300" Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Converter={x:Static converters:SslModeText.Label}}" />
                                        <TextBlock Text="Recommended" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppAccentBrush}"
                                                   IsVisible="{Binding Converter={x:Static converters:SslModeText.IsRecommended}}" />
                                    </StackPanel>
                                    <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                                               Text="{Binding Converter={x:Static converters:SslModeText.Description}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- A CA to trust instead of the OS store: the provider bundles RDS,
                 Cloud SQL and Supabase publish. Only the modes that check the
                 certificate read it, so only they show it. -->
            <StackPanel Grid.Row="7" Margin="0,0,0,8" IsVisible="{Binding ShowsRootCertificate}">
                <TextBlock Text="Root Certificate" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="RootCertificateBox" Grid.Column="0" Text="{Binding RootCertificatePath}" Margin="0,0,6,0"
                             PlaceholderText="System trust store (default)" />
                    <Button Grid.Column="1" Classes="soft" Content="Browse…" Click="OnBrowseRootCertificateClick" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="8" Margin="0,0,0,8">
                <TextBlock Text="Password" />
                <!-- revealPasswordButton = Fluent's built-in eye toggle -->
                <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" />
            </StackPanel>

            <!-- Label left, switch right: the Settings page's layout, so a switch
                 means the same thing wherever it sits. They used to lead their
                 labels, which is a checkbox's shape, not a switch's. -->
            <StackPanel Grid.Row="9" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" Background="Transparent"
                      ToolTip.Tip="Every statement runs in a read-only transaction, so the server refuses INSERT, UPDATE, DELETE and DDL. It guards against mistakes; to make writes impossible, use a role without write privileges.">
                    <TextBlock Grid.Column="0" Text="Read-only session" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ToggleSwitch Name="ReadOnlySwitch" Grid.Column="1" IsChecked="{Binding ReadOnly}" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Connect through an SSH tunnel" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ToggleSwitch Name="SshTunnelSwitch" Grid.Column="1" IsChecked="{Binding UseSshTunnel}" OnContent="" OffContent="" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="10" IsVisible="{Binding UseSshTunnel}"
                    Classes="card"
                    Padding="10" Margin="0,0,0,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="SSH Host / Port" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,80" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding SshHost}" Margin="0,0,6,0" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SshPort}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="SSH Username" />
                            <TextBox Text="{Binding SshUsername}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Auth Method" />
                            <ComboBox ItemsSource="{Binding SshAuthMethods}" SelectedItem="{Binding SshAuthMethod}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="conn:SshAuthMethod">
                                        <TextBlock Text="{Binding Converter={x:Static converters:SshAuthMethodText.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- A blank path means ssh's own defaults (id_ed25519, id_ecdsa,
                         id_rsa under ~/.ssh), which the placeholder says; ~ expands. -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8" IsVisible="{Binding IsSshKeyFileAuth}">
                        <TextBlock Text="Private Key Path" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SshPrivateKeyPath}" Margin="0,0,6,0"
                                     PlaceholderText="~/.ssh/id_ed25519 (default)" />
                            <Button Grid.Column="1" Classes="soft" Content="Browse…" Click="OnBrowseSshKeyClick" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="3" IsVisible="{Binding IsSshAgentAuth}" Margin="0,0,0,2"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                               Text="Signs in with the keys your SSH agent holds, so a key with a passphrase needs nothing typed here." />

                    <StackPanel Grid.Row="4" IsVisible="{Binding ShowsSshSecret}">
                        <TextBlock Text="{Binding SshSecretLabel}" />
                        <TextBox Text="{Binding SshPassword}" PasswordChar="•" Classes="revealPasswordButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="11">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="MediumSeaGreen" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
            </StackPanel>

        </Grid>
        </ScrollViewer>
        </Grid>

    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
        <TextBlock Text="Accessing password store…" IsVisible="{Binding IsCredentialBusy}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding CredentialWarning}" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding CredentialWarning, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- All action buttons on one row: New (scoped to the saved-connections
         column) on the left, the current form's actions on the right. New is a
         compact + under the list, where a Mac list keeps it; it used to be a
         240px bar, the widest button in the window for the least-used action.
         There is deliberately no - beside it: Delete lives in the list's
         right-click menu (UI rule 1) - it acts on a saved row, not on the form,
         and a destructive button does not belong in this row.
         There is no Save: the form saves itself as it is edited (see
         ConnectionDialogViewModel.OnFormEdited). -->

    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="240,*,Auto" Margin="0,8,0,0">
        <Button Name="NewConnectionButton" Grid.Column="0" Classes="soft" Width="32" Height="32" Padding="0"
                HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                Command="{Binding NewCommand}" ToolTip.Tip="New Connection"
                AutomationProperties.Name="New Connection">
            <PathIcon Data="{StaticResource PlusIconGeometry}" Width="14" Height="14" />
        </Button>

        <!-- The app's identity, in the one strip of the window that is always
             there and always empty: mark, name, version, centred between New and
             Connect. It replaced a separate "v1.0.0 · Copyright" line under the
             buttons, so the window gained that row back. It opens About, which is
             otherwise out of reach from this window outside macOS, and it steps
             aside if the window is ever too narrow for it next to the buttons. -->
        <Button Grid.Column="1" Classes="chip" Opacity="1" HorizontalAlignment="Center" Padding="8,4" Margin="12,0"
                Command="{Binding ShowAboutCommand}" ToolTip.Tip="{Binding FooterText}"
                IsVisible="{Binding $parent[Grid].Bounds.Width, Converter={x:Static converters:MinWidthVisibilityConverter.Instance}, ConverterParameter=580}">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Image Source="{StaticResource LogoMarkImage}" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="pgNimbus" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionLabel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="1,2,0,0" />
            </StackPanel>
        </Button>

        <!-- Right margin: the form's scrollbar gutter, so Connect's edge lines up
             with the fields' edge above it. -->
        <StackPanel Name="FormButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="0,0,14,0">
            <!-- IsDefault: Enter anywhere in the dialog connects, so a preselected
                 profile needs no click at all. Primary last, as in every dialog
                 (DESIGN.md rule 16). -->
            <Button Classes="soft" Content="Test" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsTesting}"
                    ToolTip.Tip="Verify the connection (and SSH tunnel, if enabled) without opening it" />
            <Button Name="ConnectButton" Classes="accent" Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnecting}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>


    </Grid>

    </Grid>

    <!-- The same About box the shell hosts, with the same sizing. Here because the
         connect form is often the only window open, and macOS's app-menu "About
         pgNimbus" has to land somewhere (see ConnectionDialogViewModel.IsAboutOpen). -->
    <nui:OverlayPanel IsOpen="{Binding IsAboutOpen, Mode=TwoWay}"
                      Title="About" PanelWidth="340" PanelMaxHeight="400">
        <views:AboutView />
    </nui:OverlayPanel>

    </Panel>

</Window>
