<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PgNimbus.App.Views"
        x:Class="PgNimbus.App.Views.PendingChangesDialog"
        Title="pgNimbus — Staged changes"
        Width="620" Height="460"
        MinWidth="460" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">

        <TextBlock Grid.Row="0" Name="SummaryText" Classes="dialogTitle" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Classes="dialogHint" Margin="0,0,0,6"
                   Text="This SQL runs as one transaction when you commit — everything applies, or nothing does. Each edited or deleted row is first re-read and locked: if another session changed or deleted it since you loaded it, the whole commit rolls back and shows you what changed. Values are shown inline for review; execution is parameterized." />

        <TextBlock Grid.Row="2" Name="UncheckedText" IsVisible="False" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource AppWarningBrush}" />

        <Border Grid.Row="3" Classes="card" Padding="8" Margin="0,4,0,0">
            <!-- One statement per staged row: 100,000 staged deletes are megabytes
                 of text, which ReadOnlyTextView shows in a read-only editor. -->
            <views:ReadOnlyTextView Name="SqlText"
                                    FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                    FontSize="12" />
        </Border>

        <StackPanel Grid.Row="4" Classes="dialogButtons">
            <Button Classes="soft danger" Content="Discard all" Click="OnDiscardClick" />
            <Button Classes="soft" Content="Cancel" Click="OnCancelClick" />
            <Button Name="CommitButton" Classes="accent" Content="Commit" Click="OnCommitClick" />
        </StackPanel>

    </Grid>

</Window>
