<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PgNimbus.App.ViewModels"
        xmlns:l="using:PgNimbus.App.Localization"
        xmlns:mon="using:PgNimbus.Core.Monitoring"
        x:Class="PgNimbus.App.Views.SlowQueriesWindow"
        x:DataType="vm:SlowQueriesViewModel"
        Title="{l:Tr Monitoring_SlowTitle}"
        Width="1040" Height="620"
        MinWidth="760" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- One band of chrome: the two actions left, the two choices right. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" IsVisible="{Binding HasGrid}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Classes="soft" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Tr Monitoring_SlowRefreshTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Common_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="soft" Content="{l:Tr Monitoring_SlowRestart}" Command="{Binding RestartIntervalCommand}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowRestartTip}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Monitoring_SlowRankBy}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Classes="chip" Content="{l:Tr Monitoring_SlowRankTotal}" FontSize="11" Padding="8,2"
                        Classes.active="{Binding IsRankedByTotal}"
                        Command="{Binding SetRankingCommand}" CommandParameter="{x:Static mon:StatementRanking.TotalTime}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowRankTotalTip}" />
                <Button Classes="chip" Content="{l:Tr Monitoring_SlowRankMean}" FontSize="11" Padding="8,2"
                        Classes.active="{Binding IsRankedByMean}"
                        Command="{Binding SetRankingCommand}" CommandParameter="{x:Static mon:StatementRanking.MeanTime}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowRankMeanTip}" />
                <Button Classes="chip" Content="{l:Tr Monitoring_SlowRankCalls}" FontSize="11" Padding="8,2" Margin="0,0,14,0"
                        Classes.active="{Binding IsRankedByCalls}"
                        Command="{Binding SetRankingCommand}" CommandParameter="{x:Static mon:StatementRanking.Calls}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowRankCallsTip}" />
                <Button Classes="chip" Content="{l:Tr Monitoring_SlowSinceReset}" FontSize="11" Padding="8,2"
                        Classes.active="{Binding IsSinceReset}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:False}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowSinceResetTip}" />
                <Button Classes="chip" Content="{Binding BaselineLabel}" FontSize="11" Padding="8,2"
                        Classes.active="{Binding IsSinceBaseline}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:True}"
                        ToolTip.Tip="{l:Tr Monitoring_SlowSinceTip}" />
            </StackPanel>
        </DockPanel>

        <!-- The extension missing or not loaded: say what's needed, never do it. -->
        <Border Grid.Row="1" IsVisible="{Binding HasProblem}" Classes="card" Padding="24,20"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding ProblemTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProblemDetail}" TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Classes="soft" Content="{l:Tr Monitoring_SlowOpenSetup}" Command="{Binding OpenSetupScriptCommand}"
                            ToolTip.Tip="{l:Tr Monitoring_SlowOpenSetupTip}" />
                    <Button Classes="soft" Content="{l:Tr Monitoring_SlowCheckAgain}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" IsVisible="{Binding HasGrid}">
            <DataGrid Name="StatementsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True" SelectionMode="Single"
                      CanUserResizeColumns="True" CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr Monitoring_SlowOpenInTab}" Command="{Binding OpenInNewTabCommand}" CommandParameter="{x:Null}" />
                        <MenuItem Header="{l:Tr Monitoring_SlowCopyQuery}" Click="OnCopyQueryClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding Rank}" Width="46" />
                    <DataGridTemplateColumn Header="{l:Tr Monitoring_ColQuery}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SlowQueryRow">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="↺" Foreground="{StaticResource AppWarningBrush}" IsVisible="{Binding Restarted}"
                                               ToolTip.Tip="{l:Tr Monitoring_SlowRestartedTip}" />
                                    <TextBlock Text="{Binding Query}" Classes="mono" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Query}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColRole}" Binding="{Binding Role}" Width="100" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColCalls}" Binding="{Binding Calls}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColTotal}" Binding="{Binding Total}" Width="95" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColMean}" Binding="{Binding Mean}" Width="95" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColShare}" Binding="{Binding Share}" Width="85" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColRows}" Binding="{Binding Rows}" Width="115" />
                    <DataGridTextColumn Header="{l:Tr Monitoring_ColCacheHit}" Binding="{Binding CacheHit}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False" />
        </Panel>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="11" Opacity="0.7" Margin="2,8,2,0"
                   TextWrapping="Wrap" />

    </Grid>

</Window>
