<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PgNimbus.App.Localization"
        x:Class="PgNimbus.App.Views.ImportPlanDialog"
        Title="{l:Tr Dialogs_ImportPlanTitle}"
        Width="640" Height="520"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock Classes="dialogTitle" Text="{l:Tr Dialogs_ImportPlanHeading}" />
            <TextBlock Classes="dialogHint"
                       Text="{l:Tr Dialogs_ImportPlanHint}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <TextBox Name="PlanInput"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Classes="mono" FontSize="12.5"
                     PlaceholderText="{l:Tr Dialogs_ImportPlanPlaceholder}"
                     BorderThickness="0" Background="Transparent" />
        </Border>

        <TextBlock Name="ErrorText" Grid.Row="2" IsVisible="False" Margin="0,10,0,0"
                   Foreground="{StaticResource AppDangerBrush}"
                   TextWrapping="Wrap" FontSize="12" />

        <StackPanel Grid.Row="3" Classes="dialogButtons">
            <Button Classes="soft" Content="{l:Tr Common_Cancel}" Click="OnCancelClick" />
            <Button Classes="accent" Content="{l:Tr Dialogs_ImportButton}" Click="OnImportClick" />
        </StackPanel>
    </Grid>

</Window>
