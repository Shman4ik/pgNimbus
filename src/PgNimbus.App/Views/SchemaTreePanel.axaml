<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:conv2="using:PgNimbus.App.Converters"
             xmlns:cmd="using:PgNimbus.App"
             x:Class="PgNimbus.App.Views.SchemaTreePanel"
             x:DataType="vm:SchemaTreeViewModel">
    <!-- The "Schemas" sidebar tab. DataContext is the MainViewModel's SchemaTree
         sub-ViewModel, supplied by the host. The node DataTemplates below carry
         the per-type context menus; the tree drag-to-editor, double-tap-to-browse
         and context-menu Click handlers live in the code-behind and resolve their
         actions through this sub-ViewModel's host-supplied callbacks. -->
    <UserControl.Styles>
        <!-- Applied by the SchemaNode template's Classes.excludedSchema binding;
             the whole row mutes, marker glyph included. -->
        <Style Selector="StackPanel.excludedSchema">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- On the focused tree's accent row (DESIGN.md rule 20) the text is white,
             and white at 0.45-0.6 over the brand blue is too faint to read: the dimmed
             parts come up. The child chain (row > ContentControl > template root)
             reaches the selected node's own header only; a descendant selector would
             also brighten every row of its expanded children. -->
        <Style Selector="TreeView:focus-within TreeViewItem:selected > ContentControl > :is(Panel) > TextBlock.secondary, TreeView:focus-within TreeViewItem:selected > ContentControl > TextBlock.secondary">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="TreeView:focus-within TreeViewItem:selected > ContentControl > StackPanel.excludedSchema">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SchemaNode">
            <!-- A schema excluded from autocomplete stays in the tree, dimmed and
                 marked with the eye-off glyph, so the exclusion is visible where it
                 was made and one right-click away from being undone. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Classes.excludedSchema="{Binding ExcludedFromCompletion}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New Table…" Tag="{Binding}" Click="OnNewTableClick" />
                        <MenuItem Header="Copy Name" Tag="{Binding}" Click="OnCopySchemaNameClick" />
                        <MenuItem Header="Refresh" Tag="{Binding}" Click="OnRefreshSchemaClick" />
                        <MenuItem Header="Back Up Schema…" Tag="{Binding}" Click="OnBackUpSchemaClick" />
                        <Separator />
                        <MenuItem Header="Exclude from Autocomplete" Tag="{Binding}" Click="OnToggleSchemaExcludedClick"
                                  ToggleType="CheckBox" IsChecked="{Binding ExcludedFromCompletion, Mode=OneWay}"
                                  ToolTip.Tip="Keep this schema's tables, columns and functions out of editor completion. It stays in the tree." />
                        <Separator />
                        <MenuItem Header="Drop Schema…" Tag="{Binding}" Click="OnDropSchemaClick" />
                        <MenuItem Header="Drop Schema (Cascade)…" Tag="{Binding}" Click="OnDropSchemaCascadeClick" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <PathIcon Data="{StaticResource DatabaseIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" />
                <PathIcon Data="{StaticResource EyeOffIconGeometry}" Width="11" Height="11" VerticalAlignment="Center"
                          IsVisible="{Binding ExcludedFromCompletion}"
                          ToolTip.Tip="Excluded from autocomplete" ToolTip.ShowDelay="300" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TableNode">
            <!-- A DockPanel rather than a row of inline runs: the size hint is a
                 metric, so it lines up in a right-hand column where sizes can be
                 compared at a glance, and a long name trims before it instead of
                 pushing it off the edge. -->
            <DockPanel>
                <DockPanel.ContextMenu>
                    <!-- The default action first (the same browse a double-click
                         runs, UI design rule 2), then Copy Name like the schema
                         and role menus. Alter Table… is for relations ALTER TABLE
                         can change, and Back Up Table… for relations that hold rows
                         of their own, so views and materialized views leave both out. -->
                    <ContextMenu>
                        <MenuItem Header="Browse Rows" Tag="{Binding}" Click="OnBrowseTableClick" />
                        <MenuItem Header="Copy Name" Tag="{Binding}" Click="OnCopyTableNameClick" />
                        <Separator />
                        <MenuItem Header="Source (DDL)" Tag="{Binding}" Click="OnShowSourceClick" />
                        <MenuItem Header="Alter Table…" Tag="{Binding}" Click="OnAlterTableClick" IsVisible="{Binding CanAlter}" />
                        <MenuItem Header="Back Up Table…" Tag="{Binding}" Click="OnBackUpTableClick" IsVisible="{Binding CanBackUp}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <!-- One family icon per relation kind (table/view/matview/partitioned)
                     with the exact kind on hover — same one-glyph-plus-tooltip
                     language the column type family uses -->
                <PathIcon DockPanel.Dock="Left" Margin="0,0,6,0"
                          Data="{Binding Kind, Converter={x:Static conv2:RelationKindIconConverter.Instance}}"
                          Width="12" Height="12" VerticalAlignment="Center" Opacity="0.75"
                          ToolTip.Tip="{Binding Kind, Converter={x:Static conv2:RelationKindLabelConverter.Instance}}"
                          ToolTip.ShowDelay="300" />
                <!-- Dim on-disk size hint (heap + indexes + TOAST); blank for views/partitioned parents -->
                <TextBlock DockPanel.Dock="Right" Margin="8,0,4,0"
                           Text="{Binding SizeText}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ColumnNode">
            <DockPanel>
                <Panel DockPanel.Dock="Left" Width="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource KeyIconGeometry}" Width="12" Height="12" IsVisible="{Binding IsPrimaryKey}" />
                </Panel>
                <!-- Abbreviated type (timestamptz, varchar…) with the full name on a brief
                     hover, in the same right-hand column as a table's size -->
                <TextBlock DockPanel.Dock="Right" Margin="0,0,4,0"
                           Text="{Binding DataTypeShort}" Classes="secondary" FontSize="11" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding FullTypeTip}" ToolTip.ShowDelay="150" />
                <!-- Category icon (numeric/text/date/json/enum…) — one glyph per type
                     family; enum/composite resolved from the catalog kind, domains
                     from their base type (see ColumnNode.Category) -->
                <PathIcon DockPanel.Dock="Right" Margin="8,0,5,0"
                          Data="{Binding Category, Converter={x:Static conv2:PgTypeIconConverter.Instance}}"
                          Width="11" Height="11" Opacity="0.5" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Category, Converter={x:Static conv2:PgTypeLabelConverter.Instance}}"
                          ToolTip.ShowDelay="300" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:FunctionsGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource FunctionIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Name}" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:FunctionNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowDelay="150">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Source (DDL)" Tag="{Binding}" Click="OnShowFunctionSourceClick" IsEnabled="{Binding HasSource}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ExtensionsGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource PuzzleIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ExtensionNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Description}" ToolTip.ShowDelay="150">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Install" Tag="{Binding}" Click="OnInstallExtensionClick" IsVisible="{Binding !IsInstalled}" />
                        <MenuItem Header="Drop…" Tag="{Binding}" Click="OnDropExtensionClick" IsVisible="{Binding IsInstalled}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <!-- Green dot = installed; the fixed-width panel keeps names aligned either way -->
                <Panel DockPanel.Dock="Left" Width="9" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#46A758" IsVisible="{Binding IsInstalled}" />
                </Panel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" IsVisible="{Binding IsInstalled}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Classes="secondary" IsVisible="{Binding !IsInstalled}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding VersionLabel}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:RolesGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Roles and Permissions…" Click="OnManageRolesClick" />
                        <MenuItem Header="Refresh" Tag="{Binding}" Click="OnRefreshNodeClick" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <PathIcon Data="{StaticResource AccountMultipleIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:RoleNode">
            <DockPanel HorizontalSpacing="6">
                <!-- The tree can only ever show a role's headline attributes.
                     "Roles and permissions..." opens the window on this role,
                     which is where the effective-privilege answer lives. -->
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Roles and Permissions…" Tag="{Binding}" Click="OnManageRoleClick" />
                        <MenuItem Header="Copy Name" Tag="{Binding}" Click="OnCopyRoleNameClick" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <Panel DockPanel.Dock="Left" Width="14" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource KeyIconGeometry}" Width="11" Height="11" IsVisible="{Binding IsSuperuser}" ToolTip.Tip="Superuser" />
                </Panel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding AttributesLabel}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SequencesGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource SequenceIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Name}" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SequenceNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowDelay="200">
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource SequenceIconGeometry}" Width="11" Height="11" Opacity="0.5" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TypesGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource ShapeIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Name}" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:UserTypeNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowDelay="200">
                <!-- Reuse the column type-family icon language: enum/composite have
                     their own glyph; a domain shows its base type's family icon -->
                <PathIcon DockPanel.Dock="Left" Data="{Binding Category, Converter={x:Static conv2:PgTypeIconConverter.Instance}}"
                          Width="11" Height="11" Opacity="0.55" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:IndexesGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource SortIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Name}" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:IndexNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowDelay="200">
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource SortIconGeometry}" Width="11" Height="11" Opacity="0.5" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TriggersGroupNode">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource FlashIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Name}" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TriggerNode">
            <DockPanel HorizontalSpacing="6" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowDelay="200">
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource FlashIconGeometry}" Width="11" Height="11" Opacity="0.5" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:EmptyNode">
            <TextBlock Text="{Binding Name}" Classes="secondary" FontStyle="Italic" />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderNode">
            <TextBlock Text="Loading..." Classes="secondary" FontStyle="Italic" />
        </DataTemplate>
        <DataTemplate DataType="vm:ErrorNode">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"
                       ToolTip.Tip="Collapse and expand to try again" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
        <!-- Filter box + a refresh button that reloads the tree, autocomplete, and palette from the server -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Classes="chip" Padding="5" Margin="6,0,0,0"
                    VerticalAlignment="Center" Command="{Binding RefreshAllCommand}"
                    cmd:CommandTip.Text="Reload the tree, autocomplete and palette from the server"
                    cmd:CommandTip.Command="RefreshSchema">
                <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
            </Button>
            <!-- One menu instead of a row of chips: the tree's options are all
                 secondary next to the filter box itself (UI design rule 1), and
                 four icons left the box too narrow to read what was typed in it. -->
            <Button DockPanel.Dock="Right" Classes="chip" Padding="5" Margin="6,0,0,0"
                    VerticalAlignment="Center" ToolTip.Tip="Tree options">
                <PathIcon Data="{StaticResource TuneIconGeometry}" Width="14" Height="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <!-- Off = schemas/tables + Roles only; on adds Functions/Sequences/Types
                             groups, per-table Indexes/Triggers, and Extensions -->
                        <MenuItem Header="Show Advanced Objects"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding ShowAdvancedObjects, Mode=TwoWay}"
                                  ToolTip.Tip="Also show functions, sequences, types, indexes, triggers and extensions" />
                        <Separator />
                        <!-- Expand is one level deep on purpose: a schema fetches its
                             tables on first open, so this already costs a query per schema. -->
                        <MenuItem Header="Expand All Schemas" Command="{Binding ExpandAllCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource UnfoldMoreIconGeometry}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Collapse All" Command="{Binding CollapseAllCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource UnfoldLessIconGeometry}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <!-- Type-to-filter box: case-insensitive substring over schema and table
                 names, including tables in schemas that were never expanded (the
                 filter matches the same whole-catalog list the command palette does) -->
            <TextBox Classes="sidebarFilter"
                     PlaceholderText="Filter schemas &amp; tables…"
                     Text="{Binding FilterText, Mode=TwoWay}">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="13" Height="13"
                              Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearFilterCommand}"
                            Classes="chip" Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Clear filter"
                            IsVisible="{Binding FilterText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <PathIcon Data="{StaticResource CloseIconGeometry}" Width="11" Height="11" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </DockPanel>
        <!-- Sidebar content sits directly on the shell tone, Files-style - no card chrome -->
        <Border Grid.Row="1">
            <Grid>
                <!-- No horizontal scrolling: a long name trims inside the sidebar's
                     width (widen the sidebar to read it) rather than sliding the
                     whole tree sideways, which also let an error row wrap. -->
                <!-- Every level virtualizes (TreeView.virtualizing in Styles/Theme.axaml):
                     expanding a schema of 5,000 tables realized 5,000 rows and froze the
                     window for eight seconds. The filter works on ShownSchemas and each
                     node's ShownChildren rather than on IsVisible, because a virtualizing
                     panel still realizes a hidden row to learn it takes no space. -->
                <TreeView Name="SchemaTreeView" Classes="virtualizing" ItemsSource="{Binding ShownSchemas}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, DataType=vm:SchemaTreeNode}" />
                        </Style>
                        <!-- Fluent sets these template parts' values at Template
                             priority, which a plain style never beats; a selector with
                             an activator (:not(:disabled)) is StyleTrigger priority and
                             does. Overriding the TreeViewItemExpandCollapseChevronMargin
                             resource does nothing: the template resolves it statically.
                             The header presenter stretches so a row's DockPanel can put
                             a size or a type in a right-hand column. -->
                        <Style Selector="TreeViewItem:not(:disabled) /template/ ContentPresenter#PART_HeaderPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <!-- The chevron column: 2+12+4px instead of Fluent's 12+12+12, so
                             the root row lines up with the filter box above it. -->
                        <Style Selector="TreeViewItem:not(:disabled) /template/ Panel#PART_ExpandCollapseChevronContainer">
                            <Setter Property="Margin" Value="2,0,4,0" />
                        </Style>
                        <!-- Compact per-level indent: the header's own indent is Level*16px,
                             but each nested items presenter's Margin is not template-set,
                             so a -8px counter-offset here nets out to 8px per level. -->
                        <Style Selector="TreeViewItem /template/ ItemsPresenter#PART_ItemsPresenter">
                            <Setter Property="Margin" Value="-8,0,0,0" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding ShownChildren}">
                            <ContentControl Content="{Binding}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Loading animation, two mutually-exclusive cues driven by
                     IsLoading (set by RefreshAsync): a thin indeterminate bar
                     pinned to the top only while *re*loading an already-populated
                     tree (ShowRefreshLoadingBar), and a centered "Loading schema…"
                     cue shown only for the first, empty load (ShowInitialLoadingCue).
                     Splitting them this way keeps the top bar from doubling up with
                     the centered cue on the initial load, while still never
                     overlaying existing tree items on a refresh. -->
                <ProgressBar VerticalAlignment="Top" Height="2" Margin="0,-2,0,0"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource AppAccentBrush}"
                             IsVisible="{Binding ShowRefreshLoadingBar}" />
                <!-- Nothing survived the filter. An empty panel on its own reads as a
                     broken sidebar (and, while the root groups were exempt from the
                     filter, as "found: Roles" - the one row left standing). -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="24,36,24,0" Spacing="8" IsHitTestVisible="False"
                            IsVisible="{Binding ShowNoMatches}">
                    <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="20" Height="20"
                              Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NoMatchesMessage}" FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" IsHitTestVisible="False"
                            IsVisible="{Binding ShowInitialLoadingCue}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                 Foreground="{DynamicResource AppAccentBrush}" />
                    <TextBlock Text="Loading schema…" FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                   Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap" Margin="4" FontSize="11" />
    </Grid>
</UserControl>
