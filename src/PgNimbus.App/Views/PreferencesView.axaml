<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             xmlns:views="using:PgNimbus.App.Views"
             x:Class="PgNimbus.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">


    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The strip lines up with the cards under it. -->
        <Style Selector="TabControl.settings /template/ DockPanel > Border">
            <Setter Property="Margin" Value="20,2,20,0" />
        </Style>
    </UserControl.Styles>

    <!-- Four tabs rather than one long page (2026-10): seven sections of cards
         had grown past the overlay's height, and finding a setting meant
         scrolling through all of them. The strip is the sidebar's full-width
         capsule (nimbusUi's TabControl.capsule, kubeNimbus's settings page's too),
         not TabControl.segmented, whose selection fades in on a
         transition the preferences-window baseline must never catch half-way.
         The page keeps one height whichever tab shows (PreferencesView.axaml.cs),
         so the strip never moves under the pointer. -->
    <TabControl Classes="capsule settings" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="General">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <TextBlock Classes="sectionHeader" Text="STARTUP" Margin="4,0,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Open the last connection on startup" />
                                <TextBlock Classes="hint" Text="Connects straight to whatever you used last instead of waiting at the connection dialog. The dialog is still one Switch connection away, and a failed connect lands back in it with the error." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding AutoConnectLastProfile}" />
                        </Grid>
                    </Border>

                    <TextBlock Classes="sectionHeader" Text="KEYBOARD" Margin="4,10,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Shortcut modifier" />
                                <TextBlock Classes="hint" Text="Auto uses Cmd on macOS and Ctrl elsewhere. Applies immediately to shortcuts, the command palette, and the cheat sheet." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding HotkeySchemeIndex}">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="Ctrl" />
                                <ComboBoxItem Content="Cmd" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Classes="sectionHeader" Text="HISTORY" Margin="4,10,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Record query history" />
                                <TextBlock Classes="hint" Text="Keeps the text of every query you run in a local file that is not encrypted. Passwords in statements are masked." />
                            </StackPanel>
                            <ToggleSwitch Name="RecordQueryHistorySwitch" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding RecordQueryHistory}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Appearance">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Theme" />
                                <TextBlock Classes="hint" Text="System follows the OS light/dark setting" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding ThemeIndex}">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Interface font" />
                                <TextBlock Classes="hint" Text="System is San Francisco on macOS, Segoe UI on Windows and your desktop's font on Linux. Inter looks the same everywhere." />
                            </StackPanel>
                            <ComboBox Name="InterfaceFontBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding InterfaceFontIndex}">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Inter" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Code font" />
                                <TextBlock Classes="hint" Text="For the SQL editor, values, plans and every other place that shows code. Lists the monospace fonts installed on this computer." />
                            </StackPanel>
                            <ComboBox Name="CodeFontBox" Grid.Column="1" MinWidth="200" MaxWidth="260" VerticalAlignment="Center"
                                      ItemsSource="{Binding CodeFonts}"
                                      SelectedItem="{Binding SelectedCodeFont}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CodeFontOption">
                                        <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}"
                                                   LetterSpacing="0" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Editor font size" />
                                <TextBlock Classes="hint" Text="{Binding EditorFontSizeHint}"
                                           FontFamily="{DynamicResource KeyCapFont}" />
                            </StackPanel>
                            <NumericUpDown Name="EditorFontSizeBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                           Minimum="{x:Static vm:PreferencesViewModel.MinEditorFontSize}"
                                           Maximum="{x:Static vm:PreferencesViewModel.MaxEditorFontSize}"
                                           Increment="1" FormatString="0"
                                           Value="{Binding EditorFontSize}" />
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Show relation sizes in the schema tree" />
                                <TextBlock Classes="hint" Text="Adds each table and materialized view's on-disk size (heap + indexes + TOAST) as a dim hint next to its name" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding ShowSchemaSizes}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Editor">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <TextBlock Classes="sectionHeader" Text="COMPLETION" Margin="4,0,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Auto-alias tables from completion" />
                                <TextBlock Classes="hint" Text="Accepting a table after FROM/JOIN also inserts a short alias (orders → orders o)" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding AutoAliasTables}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Keyword case" />
                                <TextBlock Classes="hint" Text="How accepted keywords are written. As typed follows what you started: tr gives true, SEL gives SELECT." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding KeywordCaseIndex}">
                                <ComboBoxItem Content="As typed" />
                                <ComboBoxItem Content="UPPER" />
                                <ComboBoxItem Content="lower" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Always write the table's schema" />
                                <TextBlock Classes="hint" Text="Off, a table goes in bare when the search_path finds it (customers), and with its schema otherwise (saas.users). On, every table goes in with its schema." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding CompletionAlwaysQualifyTables}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Enter accepts a suggestion" />
                                <TextBlock Classes="hint" Text="On, Enter takes a suggestion you picked or started typing, and is a newline otherwise. Off, only Tab accepts and Enter always ends the line." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding CompletionEnterAccepts}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Data">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Safe mode (stage &amp; review changes)" />
                                <TextBlock Classes="hint" Text="Grid edits, deletes, and Add-row inserts are staged locally and highlighted; review the generated SQL, then commit everything as one transaction — or discard" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding SafeModeEdits}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="Always show the filter bar while browsing" />
                                <TextBlock Classes="hint" Text="Keeps the filter line above the grid even with no conditions, so + Filter is always in reach. Off, it appears whenever a condition (or a WHERE you typed) filters the rows. Also toggled by the funnel in the status bar." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding ShowFilterBar}" />
                        </Grid>
                    </Border>

                    <!-- Which pg_dump and pg_restore backups run with. Found on its
                         own almost always; this is where to point at a folder the
                         search can't know, and where to see what it found. -->
                    <TextBlock Classes="sectionHeader" Text="BACKUP" Margin="4,10,4,4" />
                    <Border Name="PgToolsCard" Classes="card" Padding="14,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Classes="label" Text="PostgreSQL client programs" />
                                    <TextBlock Classes="hint" Text="pg_dump and pg_restore make and restore backups. pgNimbus finds them where PostgreSQL, pgAdmin, Postgres.app and Homebrew install them." />
                                    <TextBlock Name="PgToolsStatus" Classes="hint" Text="{Binding PgTools.StatusLine}"
                                               TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0" />
                                    <TextBlock Classes="hint" Text="{Binding PgTools.FolderLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="soft" Content="Choose Folder…" HorizontalAlignment="Stretch"
                                            Click="OnChooseToolsFolderClick"
                                            ToolTip.Tip="Pick the folder that holds pg_dump and pg_restore" />
                                    <Button Classes="soft" Content="Look Again" HorizontalAlignment="Stretch"
                                            Command="{Binding PgTools.LookAgainCommand}" />
                                    <Button Classes="soft" Content="Automatic" HorizontalAlignment="Stretch"
                                            Command="{Binding PgTools.UseAutomaticSearchCommand}"
                                            IsVisible="{Binding PgTools.IsConfigured}"
                                            ToolTip.Tip="Forget the folder and search again" />
                                </StackPanel>
                            </Grid>
                            <views:PgToolGuideView DataContext="{Binding PgTools}" IsVisible="{Binding IsMissing}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>
