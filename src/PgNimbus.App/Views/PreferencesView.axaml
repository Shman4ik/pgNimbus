<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PgNimbus.App.ViewModels"
             xmlns:views="using:PgNimbus.App.Views"
             xmlns:l="using:PgNimbus.App.Localization"
             xmlns:lk="using:PgNimbus.Core.Localization"
             x:Class="PgNimbus.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">


    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The strip lines up with the cards under it. -->
        <Style Selector="TabControl.settings /template/ DockPanel > Border">
            <Setter Property="Margin" Value="20,2,20,0" />
        </Style>
    </UserControl.Styles>

    <!-- Four tabs rather than one long page (2026-10): seven sections of cards
         had grown past the overlay's height, and finding a setting meant
         scrolling through all of them. The strip is the sidebar's full-width
         capsule (nimbusUi's TabControl.capsule, kubeNimbus's settings page's too),
         not TabControl.segmented, whose selection fades in on a
         transition the preferences-window baseline must never catch half-way.
         The page keeps one height whichever tab shows (PreferencesView.axaml.cs),
         so the strip never moves under the pointer. -->
    <TabControl Classes="capsule settings" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="{l:Tr Settings_TabGeneral}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_LanguageSection}" Margin="4,0,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_Language}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_LanguageHint}" />
                            </StackPanel>
                            <ComboBox Name="LanguageBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_StartupSection}" Margin="4,10,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_AutoConnect}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_AutoConnectHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding AutoConnectLastProfile}" />
                        </Grid>
                    </Border>

                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_KeyboardSection}" Margin="4,10,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_ShortcutModifier}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_ShortcutModifierHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding HotkeySchemeIndex}">
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ModifierAuto}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ModifierCtrl}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ModifierCmd}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_HistorySection}" Margin="4,10,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_RecordHistory}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_RecordHistoryHint}" />
                            </StackPanel>
                            <ToggleSwitch Name="RecordQueryHistorySwitch" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding RecordQueryHistory}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Tr Settings_TabAppearance}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_Theme}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_ThemeHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding ThemeIndex}">
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ThemeSystem}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ThemeLight}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_ThemeDark}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_InterfaceFont}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_InterfaceFontHint}" />
                            </StackPanel>
                            <ComboBox Name="InterfaceFontBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding InterfaceFontIndex}">
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_FontSystem}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_FontInter}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_CodeFont}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_CodeFontHint}" />
                            </StackPanel>
                            <ComboBox Name="CodeFontBox" Grid.Column="1" MinWidth="200" MaxWidth="260" VerticalAlignment="Center"
                                      ItemsSource="{Binding CodeFonts}"
                                      SelectedItem="{Binding SelectedCodeFont}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CodeFontOption">
                                        <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}"
                                                   LetterSpacing="0" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_EditorFontSize}" />
                                <TextBlock Classes="hint" Text="{Binding EditorFontSizeHint}"
                                           FontFamily="{DynamicResource KeyCapFont}" />
                            </StackPanel>
                            <NumericUpDown Name="EditorFontSizeBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                           Minimum="{x:Static vm:PreferencesViewModel.MinEditorFontSize}"
                                           Maximum="{x:Static vm:PreferencesViewModel.MaxEditorFontSize}"
                                           Increment="1" FormatString="0"
                                           Value="{Binding EditorFontSize}" />
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_ShowSizes}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_ShowSizesHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding ShowSchemaSizes}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Tr Settings_TabEditor}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_CompletionSection}" Margin="4,0,4,4" />
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_AutoAlias}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_AutoAliasHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding AutoAliasTables}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_KeywordCase}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_KeywordCaseHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                      SelectedIndex="{Binding KeywordCaseIndex}">
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_KeywordCaseAsTyped}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_KeywordCaseUpper}" />
                                <ComboBoxItem Content="{x:Static lk:StringKey.Settings_KeywordCaseLower}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_AlwaysQualify}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_AlwaysQualifyHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding CompletionAlwaysQualifyTables}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_EnterAccepts}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_EnterAcceptsHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding CompletionEnterAccepts}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Tr Settings_TabData}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,20" Spacing="6">
                    <Border Classes="card" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_SafeMode}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_SafeModeHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding SafeModeEdits}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="14,12" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="{l:Tr Settings_FilterBar}" />
                                <TextBlock Classes="hint" Text="{l:Tr Settings_FilterBarHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding ShowFilterBar}" />
                        </Grid>
                    </Border>

                    <!-- Which pg_dump and pg_restore backups run with. Found on its
                         own almost always; this is where to point at a folder the
                         search can't know, and where to see what it found. -->
                    <TextBlock Classes="sectionHeader" Text="{l:Tr Settings_BackupSection}" Margin="4,10,4,4" />
                    <Border Name="PgToolsCard" Classes="card" Padding="14,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Classes="label" Text="{l:Tr Settings_PgTools}" />
                                    <TextBlock Classes="hint" Text="{l:Tr Settings_PgToolsHint}" />
                                    <TextBlock Name="PgToolsStatus" Classes="hint" Text="{Binding PgTools.StatusLine}"
                                               TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0" />
                                    <TextBlock Classes="hint" Text="{Binding PgTools.FolderLabel}" IsVisible="{Binding PgTools.ShowsFolderLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="soft" Content="{l:Tr Settings_PgToolsChooseFolder}" HorizontalAlignment="Stretch"
                                            Click="OnChooseToolsFolderClick"
                                            ToolTip.Tip="{l:Tr Settings_PgToolsChooseFolderTip}" />
                                    <Button Classes="soft" Content="{l:Tr Settings_PgToolsLookAgain}" HorizontalAlignment="Stretch"
                                            Command="{Binding PgTools.LookAgainCommand}" />
                                    <Button Classes="soft" Content="{l:Tr Settings_PgToolsAutomatic}" HorizontalAlignment="Stretch"
                                            Command="{Binding PgTools.UseAutomaticSearchCommand}"
                                            IsVisible="{Binding PgTools.IsConfigured}"
                                            ToolTip.Tip="{l:Tr Settings_PgToolsAutomaticTip}" />
                                </StackPanel>
                            </Grid>
                            <views:PgToolGuideView DataContext="{Binding PgTools}" IsVisible="{Binding IsMissing}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>
