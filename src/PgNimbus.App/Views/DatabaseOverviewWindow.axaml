<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PgNimbus.App.ViewModels"
        xmlns:l="using:PgNimbus.App.Localization"
        x:Class="PgNimbus.App.Views.DatabaseOverviewWindow"
        x:DataType="vm:DatabaseOverviewViewModel"
        Title="{l:Tr Monitoring_OverviewTitle}"
        Width="960" Height="600"
        MinWidth="720" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
            <Button Classes="soft" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Tr Monitoring_OverviewRefreshTip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Tr Common_Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Summary stats -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="36">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Monitoring_OverviewDatabase}" Classes="sectionHeader" />
                    <TextBlock Text="{Binding DatabaseName}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Monitoring_OverviewSize}" Classes="sectionHeader" />
                    <TextBlock Text="{Binding DatabaseSizeText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="2" ToolTip.Tip="{l:Tr Monitoring_OverviewTableCacheTip}">
                    <TextBlock Text="{l:Tr Monitoring_OverviewTableCache}" Classes="sectionHeader" />
                    <TextBlock Text="{Binding TableCacheHitText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="2" ToolTip.Tip="{l:Tr Monitoring_OverviewIndexCacheTip}">
                    <TextBlock Text="{l:Tr Monitoring_OverviewIndexCache}" Classes="sectionHeader" />
                    <TextBlock Text="{Binding IndexCacheHitText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Classes="segmented">
            <TabItem Header="{l:Tr Monitoring_OverviewTabLargest}">
                <DataGrid ItemsSource="{Binding LargestRelations}" IsReadOnly="True" SelectionMode="Single"
                          CanUserResizeColumns="True" CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColSchema}" Binding="{Binding Schema}" Width="120" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColName}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColKind}" Binding="{Binding Kind}" Width="100" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColRowsEstimate}" Binding="{Binding Rows}" Width="110" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColTable}" Binding="{Binding TableSize}" Width="100" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColIndexes}" Binding="{Binding IndexSize}" Width="100" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColTotal}" Binding="{Binding Total}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{l:Tr Monitoring_OverviewTabScans}">
                <DataGrid ItemsSource="{Binding TableScans}" IsReadOnly="True" SelectionMode="Single"
                          CanUserResizeColumns="True" CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColSchema}" Binding="{Binding Schema}" Width="120" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColName}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColSeqScans}" Binding="{Binding SeqScan}" Width="110" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColIndexScans}" Binding="{Binding IdxScan}" Width="110" />
                        <DataGridTemplateColumn Header="{l:Tr Monitoring_ColIndexPercent}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TableScanRow">
                                    <Panel Margin="12,0">
                                        <!-- A big table read mostly sequentially is worth spotting - amber + bold -->
                                        <TextBlock Text="{Binding IndexScanPercent}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold"
                                                   IsVisible="{Binding IsSeqScanHeavy}" />
                                        <TextBlock Text="{Binding IndexScanPercent}" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsSeqScanHeavy}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColLiveRows}" Binding="{Binding LiveRows}" Width="110" />
                        <DataGridTextColumn Header="{l:Tr Monitoring_ColDeadRows}" Binding="{Binding DeadRows}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{l:Tr Monitoring_OverviewTabUnused}">
                <Grid RowDefinitions="*,Auto">
                    <DataGrid Grid.Row="0" ItemsSource="{Binding UnusedIndexes}" IsReadOnly="True" SelectionMode="Single"
                              CanUserResizeColumns="True" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr Monitoring_ColSchema}" Binding="{Binding Schema}" Width="120" />
                            <DataGridTextColumn Header="{l:Tr Monitoring_ColTable}" Binding="{Binding Table}" Width="200" />
                            <DataGridTextColumn Header="{l:Tr Monitoring_ColIndex}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{l:Tr Monitoring_ColSize}" Binding="{Binding Size}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="4,8,4,0" FontSize="11" Opacity="0.6"
                               Text="{l:Tr Monitoring_OverviewUnusedNote}" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Classes="statusMessage" Text="{Binding Status}" FontSize="11" Opacity="0.7" Margin="2,8,2,0" />

    </Grid>

</Window>
