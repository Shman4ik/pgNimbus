<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same platform contract as PgNimbus.Core.Tests: TUnit on
         Microsoft.Testing.Platform, so the test project is its own executable
         and must NOT reference Microsoft.NET.Test.Sdk. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The App turns the trim/AOT analyzers on; a test host is never published
         AOT and Avalonia.Headless is not annotated for it. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.65.68" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Screenshot tool is where the offline fixture graph lives (an
         NpgsqlDataSource that opens no socket, a seeded schema tree, seeded
         result sets). These tests drive the same windows the harness renders,
         so they take that fixture set rather than growing a second one that
         would drift away from what the screenshots show. -->
    <ProjectReference Include="..\tools\Screenshot\Screenshot.csproj" />
    <ProjectReference Include="..\PgNimbus.App\PgNimbus.App.csproj" />
  </ItemGroup>

</Project>
