<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Nimbus.Ui.Controls">

    <!--
        Fluent control retheming: the stock controls both apps use, toned to the
        Nimbus surface. Everything here restyles a control BOTH apps put on screen
        constantly — inputs, lists, grids, secondary buttons — which is why it is
        shared rather than duplicated.

        This file exists because the first extraction only pulled up the *shell*
        vocabulary (card / layer / chip / searchpill / toolbar / accent, tokens,
        scrollbars) and left the control layer behind in pgNimbus. The result was
        that kubeNimbus rendered every TextBox, ComboBox, ListBox, TreeView and
        DataGrid as raw Fluent next to pgNimbus's toned versions — two apps sharing
        a design system and visibly not looking like it. If a style below is
        changed, it changes both apps: that is the point of it being here.

        What deliberately stayed per-app, and why:
          - Bare `TabItem` / `TabItem:selected` — each app's own. The one tab strip
            both apps draw, the full-width capsule, is shared as `TabControl.capsule`
            in the Tabs section below.
          - `TabControl.segmented` — pgNimbus's segmented strip. kubeNimbus does
            the same job with `ListBox.segmented` + `TabControl.headerless` on
            purpose, because a TabControl cannot host a panel's own tools on its
            header row and its inspector dock needs exactly that. Sharing a
            mechanism the sibling has explicitly rejected buys nothing.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Merged again here, exactly as Theme.axaml does and for the same
                    reason: a StaticResource in a styles file resolves against that
                    file's own resource chain. Without this every token below fails
                    at XAML load rather than at build.
                -->
                <ResourceInclude Source="avares://Nimbus.Ui/Theme/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ==================================================================
         Buttons
         ================================================================== -->

    <!-- Filled destructive primary button — the affirmative of a destructive
         confirm (Delete / Drop / Terminate / Discard). Mirrors .accent, in red. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource AppDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
    </Style>

    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{StaticResource AppDangerPressedBrush}" />
    </Style>

    <Style Selector="Button.danger:disabled">
        <Setter Property="Background" Value="{DynamicResource SystemControlDisabledBaseLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
    </Style>

    <!-- Fluent repaints PART_ContentPresenter on hover and press from its own
         ButtonBackground* resources, so the item-level states above never drew: a
         red button went grey under the pointer. Pinned on the part, as .accent is. -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppDangerPressedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Checked state for chip-styled ToggleButtons. Fluent paints the checked fill
         on PART_ContentPresenter via its ControlTheme, which outranks a plain
         Background setter, so the wash has to override that template part; hover and
         pressed are both pinned so an "on" chip stays blue rather than flipping to
         Fluent's grey under the pointer. (The rest state lives in Theme.axaml
         alongside the other chip rules.) -->
    <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>

    <Style Selector="ToggleButton.chip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>

    <!-- The `Button.chip.active` wash is NOT here, though it belongs beside these.
         It sets the same Background and Opacity as the base `Button.chip` rule in
         Theme.axaml, which is loaded after this file, and Avalonia has no selector
         specificity: for one property the later style wins. Here, the base rule
         silently reset every active chip to transparent at 0.6. It lives after the
         base rule in Theme.axaml (CLAUDE.md hard rule 7). -->

    <!-- Soft action button: a refined, tactile pill (card-toned fill + hairline
         border) that reads as a real button, unlike the flat transparent .toolbar
         variant. Hover lifts to the accent tint. Fluent repaints
         PART_ContentPresenter on hover, so the states are pinned at the template
         part (same trick as .searchpill). Add .danger for destructive actions. -->
    <Style Selector="Button.soft">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="Button.soft /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <!-- Disabled soft button: quiet, no border glow -->
    <Style Selector="Button.soft:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Destructive variant: red glyph/text, red hover wash. -->
    <Style Selector="Button.soft.danger">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
    </Style>

    <Style Selector="Button.soft.danger PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
    </Style>

    <Style Selector="Button.soft.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppDangerWashBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
    </Style>

    <Style Selector="Button.soft.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppDangerWashBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
    </Style>

    <!-- A disabled destructive button must not still shout red: .soft:disabled's
         0.4 opacity over AppDangerBrush lands on a washed-out pink that reads as
         "broken", not "unavailable". Drop back to the ordinary foreground so it
         dims like every other disabled button. -->
    <Style Selector="Button.soft.danger:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="Button.soft.danger:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <!-- Toggle variant of .soft, for an on/off action that belongs in the same
         button group as its neighbours. A .chip there would sit at a different
         height and radius, and its checked blue wash reads as a *selected tab* —
         which is what a segmented strip beside it already means. This keeps the
         .soft pill geometry and marks "on" with the accent border + wash. Fluent
         repaints PART_ContentPresenter for every ToggleButton state, so each state
         is pinned at the template part, and selectors match by style key — so
         ToggleButton needs its own rules rather than inheriting the Button.soft
         ones. -->
    <Style Selector="ToggleButton.soft">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft:checked">
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Fluent's ControlTheme also paints checked-state Foreground on the inner
         PART_ContentPresenter (ToggleButtonForegroundChecked, meant for its own
         solid accent-filled background). That Template-priority setter outranks
         the plain Foreground above, so without pinning it here the pill renders
         Fluent's near-white checked text over our translucent AppSelectionBrush
         wash instead of AppAccentBrush - low-contrast, barely-legible text
         (see the "Auto" toggle in the Activity window). Same fix as the
         Background/BorderBrush pins below. -->
    <Style Selector="ToggleButton.soft:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.soft:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- ==================================================================
         Tabs
         ================================================================== -->

    <!-- The container only: transparent, and no padding of its own, so a tab's
         content sits flush against whatever surface hosts it. Bare `TabItem` is
         deliberately NOT here; only the capsule strip below is (DESIGN.md's
         not-shared table). -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- TabControl.capsule: one full-width capsule across the top, split into equal
         segments, the selected one raised on the track. pgNimbus's sidebar switch
         (Schemas / Queries) and both apps' settings pages use it. It was pgNimbus's
         `TabControl.sidebar` until kubeNimbus's settings page went to tabs too
         (2026-10); a settings page that looks different in each app is what DESIGN.md
         says the pair must not do.

         No transition on the selection, on purpose: TabControl.segmented's 140 ms fade
         is something a screenshot baseline can catch half-way.

         An app's own styles load after this file, and file order is the only
         precedence (this library's CLAUDE.md, rule 7): an app style on bare `TabItem`
         would beat `TabControl.capsule > TabItem` here. An app that styles bare
         `TabItem` scopes it away from the capsule (`TabControl:not(.capsule) > TabItem`). -->
    <Style Selector="TabControl.capsule">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_StripBorder"
                            DockPanel.Dock="Top"
                            Background="{DynamicResource AppSegmentTrackBrush}"
                            CornerRadius="7"
                            Padding="2">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      Padding="{TemplateBinding Padding}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Fluent's TabControl theme gives the part named PART_ItemsPresenter a bottom
         margin (TabControlTopPlacementItemMargin) from an activated selector, which
         beats the template's own value; the selected segment sat 2px from the
         strip's top and 4px from its bottom. -->
    <Style Selector="TabControl.capsule /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabControl.capsule > TabItem">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.capsule > TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TabControl.capsule > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <!-- The selected segment is a raised surface on the track, in the body's own
         text colour: the accent wash with accent SemiBold text it replaced (2026-10)
         read as a selected list row, and was the heaviest thing in the sidebar. -->
    <Style Selector="TabControl.capsule > TabItem:selected">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TabControl.capsule > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TabControl.capsule > TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppSegmentThumbBrush}" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #1F000000, 0 0 1 0 #1A000000" />
    </Style>

    <!-- ==================================================================
         Lists and trees
         ================================================================== -->

    <!-- Rounded row selection instead of Fluent's edge-to-edge highlight bars.
         An app that wants a different row shape overrides on its own class
         (kubeNimbus does exactly that for its switcher and segmented strips). -->
    <Style Selector="ListBox, TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Rows are ~24px, the density of a native list (DESIGN.md rule 20): Fluent's
         12,9,12,12 item padding made a two-word row 38px tall. No focus ring on a
         row either: the focused list says so with its accent selection below, the
         way a macOS sidebar does, and a ring around the selected row on top of that
         is the same fact drawn twice. -->
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Panel />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- Row states are pinned on the template part. Fluent's ListBoxItem theme paints
         the selected fill on PART_ContentPresenter from the OS accent at 60-80%
         opacity, so a Background set on the item itself is never drawn: this rule
         used to be `ListBoxItem:selected { Background }` and every list in both apps
         (pgNimbus's query tabs and saved connections among them) showed a saturated
         OS-blue slab instead of the brand wash, the one selection surface that broke
         DESIGN.md rule 11. kubeNimbus had worked around it per list, three times. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionHoverBrush}" />
    </Style>

    <!-- Selection has two faces (DESIGN.md rule 20). In a list that does not hold
         keyboard focus, the selected row is neutral grey with ordinary text... -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionInactiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <!-- ...and in the list the keyboard is driving, it is the solid accent with white
         text and icons. `emphasized` is for a list driven from a search box beside it
         that never takes focus itself (a command palette): as far as the user can
         tell, it is always the focused list. -->
    <Style Selector="ListBox:focus-within ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.emphasized ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Secondary text in a row (`TextBlock.secondary`, rule 17's 0.6) comes up on the
         accent fill: white at 0.6 over the brand blue is under 2.5:1. -->
    <Style Selector="ListBox:focus-within ListBoxItem:selected TextBlock.secondary, ListBox.emphasized ListBoxItem:selected TextBlock.secondary">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- A strip of choices laid out as a list (a tab strip, a row of result
         sections) is not a list of rows: its selected item means "the one showing",
         which a solid accent slab would overstate. It keeps the light wash whether
         or not it has focus. Loaded after the two rules above, so it wins. -->
    <Style Selector="ListBox.strip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="ListBox.strip ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionHoverBrush}" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="4,2" />
        <!-- ~24px rows, down from Fluent's 32 (and this file's own 26 before rule 20). -->
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Panel />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>

    <!-- The same two faces as a list row. The header presenter and the chevron are
         coloured rather than the item, so a selected node's expanded children (which
         sit inside the item) keep their own colours. -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{StaticResource AppSelectionInactiveBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter, TreeView:focus-within TreeViewItem:selected /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- Secondary text, app-wide: rule 17's 0.6. A class rather than a local
         Opacity so that a selected row can bring it up (above); a local value
         outranks every style. -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- ==================================================================
         Toggle switch
         ================================================================== -->

    <!-- ToggleSwitch is a whole ControlTheme, in Theme/ToggleSwitch.axaml (merged by
         Theme.axaml): its sizes are set in Fluent's template at Template priority,
         which no style here can override. -->

    <!-- ==================================================================
         Keyboard focus
         ================================================================== -->

    <!-- One rounded accent ring for everything that takes focus and does not draw
         its own (DESIGN.md rule 20; Controls/FocusRing.cs). The adorner layer hands
         this to any control whose FocusAdorner is unset. -->
    <Style Selector="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <controls:FocusRing />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|FocusRing">
        <Setter Property="BorderBrush" Value="{StaticResource AppFocusRingBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Outset" Value="2" />
    </Style>

    <!-- ==================================================================
         Menus
         ================================================================== -->

    <!-- Context menus and menu flyouts at native density (DESIGN.md rule 20): 13px
         items in ~24px rows, the highlighted item a 4px-rounded accent pill inset
         from the menu's 6px-rounded edge, with white text. Fluent's were 14px
         items in 32px rows under a faint grey highlight running edge to edge. -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource AppPopupBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="0,4" />
    </Style>

    <!-- The radius goes on the item, which Fluent template-binds to the highlight
         border; set on the border itself it loses to that binding. -->
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ TextBlock#PART_InputGestureText, MenuItem:selected /template/ ContentControl#PART_IconPresenter, MenuItem:selected /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="MenuItem:selected /template/ Path#PART_ChevronPath">
        <Setter Property="Fill" Value="White" />
    </Style>

    <!-- Loaded after the highlight: a disabled item never lights up. -->
    <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ==================================================================
         Inputs and text
         ================================================================== -->

    <!-- Rounded to match the rest of the surface. -->
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!-- Selected text in every plain TextBox uses the brand-blue wash instead of
         FluentTheme's OS-accent-derived default (rule 11: the accent is ours, never
         the OS's). SelectionBrush is a TextBox-only property — not exposed on
         ComboBox/NumericUpDown — hence its own selector; it still reaches the
         editable TextBox inside a NumericUpDown's template. -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{StaticResource AppTextSelectionBrush}" />
    </Style>

    <!-- A one-line box centres its text and placeholder. Fluent leaves them at the
         top of the padding (6 over, 5 under) and gives the box a fixed MinHeight,
         so any box whose font is smaller than the one that MinHeight was sized for
         showed its text a few pixels high: the 12px sidebar filter's placeholder
         sat visibly above its magnifier, and the 13px body text did the same in
         every field of the connect form on macOS. A multi-line box keeps its text
         at the top, where the first line belongs. -->
    <Style Selector="TextBox[AcceptsReturn=False]">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Read-only selectable text shares the same wash. Otherwise it falls back to
         Fluent's grey OS-accent default and selection reads differently there than
         in an editable box two inches away. -->
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{StaticResource AppTextSelectionBrush}" />
    </Style>

    <!-- ==================================================================
         Data grid
         ================================================================== -->

    <!-- Soft horizontal rules instead of a full grid, faint enough to guide the eye
         along a dense single-line row without ruling the table into boxes. They used
         to be BaseLow, which in the dark theme was the brightest line on the page
         (DESIGN.md rule 14). The per-cell gutter and the cell text size that go with
         this are rule 12 and live in each app, since the column widths they have to
         be balanced against are the app's own. -->
    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#1A808080" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Zebra rows (DESIGN.md rule 20), opt-in per grid: every other row a shade
         off (AppAltRowBrush), and no rules, since the stripes already lead the eye
         along a row. The DataGrid has no alternating-row property and no odd/even
         pseudo-class, and it recycles rows, so the grid's owner sets the `odd` class
         from the row's index as each row is loaded (DataGrid.LoadingRow). -->
    <Style Selector="DataGrid.zebra">
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>

    <Style Selector="DataGrid.zebra DataGridRow.odd">
        <Setter Property="Background" Value="{DynamicResource AppAltRowBrush}" />
    </Style>

    <!-- Column headers in the section-header type: small, semibold, dimmed. And no
         background of their own: Fluent paints the header row in AltHigh, pure black
         in the dark theme, which vanishes on a `layer` and is a black band across the
         top of any grid that sits in a `card` or on the shell tone. -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

</Styles>
