<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Nimbus palette. PowerToys/Files-inspired: soft rounded cards, pill-shaped
        nav selection, accent-coloured primary actions. Neutral surfaces stay driven off
        FluentTheme's DynamicResource brushes so light/dark keeps working; everything
        with a hue is fixed and defined here.

        Names carry the `App` prefix throughout. That is not decoration — it is what
        tells a Nimbus token apart from one of Fluent's several hundred, at the point of
        use, in an app where both are in scope.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <!--
            Windows 11 Mica: the translucent base tone the backdrop shows through.
            Theme-split so the frost reads right in light/dark; only applied when the
            platform honors Mica.

            Alpha kept high (~90%): Avalonia's Mica shows the wallpaper more strongly
            than native Windows Mica, so a thinner frost let a dark wallpaper darken the
            base until dimmed text (breadcrumbs, section headers) went grey-on-grey.
            0xE6 keeps a stable tinted surface with just a hint of the backdrop.
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#E6F3F3F3" />
            <SolidColorBrush x:Key="AppLayerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppPopupBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#4D000000" />
            <!-- Every other row of a zebra table (`DataGrid.zebra`): a shade under the
                 row it alternates with, the way a macOS table stripes. -->
            <SolidColorBrush x:Key="AppAltRowBrush" Color="#0A000000" />
            <!-- A flat icon button under the pointer (`chip`, `toolbar`): a visible
                 grey, not the 5% HoverBackgroundBrush a list row uses. -->
            <SolidColorBrush x:Key="AppToolbarHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="AppToolbarPressedBrush" Color="#24000000" />
            <!-- A switch that is off: a filled grey track, not Fluent's outline. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#24000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#30000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#3D000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#12000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellBackdropBrush" Color="#E6202020" />
            <SolidColorBrush x:Key="AppLayerBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="AppPopupBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#80000000" />
            <!-- Fluent fills a focused text box with ChromeBlackHigh: pure black, so
                 clicking into a field punched a #000 hole in a grey dialog, and a
                 multi-line box (a pasted plan, a script) went black while you typed.
                 Focus keeps the resting well's tone; the accent underline says focus. -->
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#66000000" />
            <SolidColorBrush x:Key="AppAltRowBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="AppToolbarHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppToolbarPressedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#1AFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        The three raised surfaces, lightest last. Fluent's own "page" brush
        (SystemControlPageBackgroundAltHighBrush) is what `layer`, every popup and
        every secondary window used to paint with, and in the dark theme it is pure
        black: a #000 work area inside a #2B2B2B shell, the harshest contrast in the
        app, and the opposite of how Windows 11 layers a dark UI (a raised surface is
        lighter than the base it sits on, in both themes). Light keeps white, which
        already read as raised; dark gets greys that do.

          AppLayerBrush  - `layer`: the work area and an overlay's card.
          AppPopupBrush  - what floats over a layer (completion list, argument hint,
                           command palette, the find bar), a step lighter again so it
                           separates from the editor it sits on without leaning on its
                           shadow alone.
          AppScrimBrush  - the dim behind a modal overlay. One value for every
                           overlay: the palette, the cell inspector and OverlayPanel
                           had drifted to two different alphas.

        All three are theme-split, so reference them with DynamicResource.
    -->

    <!--
        Fixed brand accent, theme-independent. Deliberately NOT the OS
        SystemAccentColor: the Windows accent can land anywhere on the wheel (neon
        green, magenta…), and every selection/hover/primary surface then has to stay
        legible against an unknown hue — not worth the polish cost. A fixed blue we
        control keeps contrast predictable, and keeps the two apps looking like one
        family on a machine whose accent is orange.
    -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2D7FF9" />
    <!--
        The same blue as Fluent's accent palette. Fluent reads SystemAccentColor (and
        its three lighter and three darker steps) from the OS, and paints with it
        wherever an app has not pinned a template part: an `accent` button at rest,
        a checked box, a toggle switch that is on, a focus ring. So a DESIGN.md
        rule 11 app still followed the Windows accent on those, and nobody saw it
        because the headless renders use Avalonia's default blue: on a machine whose
        accent is grey, Connect and Run were grey buttons (found 2026-09-28).
        Defined here, after FluentTheme, these win every DynamicResource lookup.
    -->
    <Color x:Key="SystemAccentColor">#2D7FF9</Color>
    <Color x:Key="SystemAccentColorLight1">#4A93FA</Color>
    <Color x:Key="SystemAccentColorLight2">#74ABFB</Color>
    <Color x:Key="SystemAccentColorLight3">#A0C6FD</Color>
    <Color x:Key="SystemAccentColorDark1">#1E63D6</Color>
    <Color x:Key="SystemAccentColorDark2">#1850AE</Color>
    <Color x:Key="SystemAccentColorDark3">#123C83</Color>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#4A93FA" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#1E63D6" />
    <!-- Low-alpha accent for row/pill selection washes; reads on both themes. -->
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#282D7FF9" />
    <!-- The same wash under the pointer: a selected row still answers a hover. -->
    <SolidColorBrush x:Key="AppSelectionHoverBrush" Color="#3C2D7FF9" />
    <!--
        App-wide text-selection wash, shared by every TextBox and both apps' code
        editors. A bit more alpha than AppSelectionBrush (0x40 vs 0x28): a text run
        under the cursor needs to read as clearly selected even one character wide, and
        the translucency lets the underlying text colour show through. Tune the alpha
        here to make selection stronger/weaker across both apps.
    -->
    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#402D7FF9" />

    <!--
        Row selection, the macOS way (DESIGN.md rule 20). A list or tree that holds
        keyboard focus shows its selected row as a solid accent fill with white text
        (AppAccentBrush); the same row in a list that does not have focus is a neutral
        grey (this brush) with the ordinary text colour, so the one list the keyboard
        is driving is the one that looks it. Fixed-alpha grey, like the card brushes,
        so it reads on the shell, a layer and a card in both themes.
    -->
    <SolidColorBrush x:Key="AppSelectionInactiveBrush" Color="#40808080" />

    <!--
        The keyboard focus ring (DESIGN.md rule 20): semi-transparent brand accent,
        drawn by Nimbus.Ui.Controls.FocusRing around whatever holds focus and rounded
        to that control's own corners. It replaced Fluent's default adorner, a 2px
        black (white in dark) rectangle with a 1px inner rule, which is what a
        focused tree row or toolbar button used to be drawn with.
    -->
    <SolidColorBrush x:Key="AppFocusRingBrush" Color="#8C2D7FF9" />
    <!-- The same for the few templates that draw their own focus visual from these
         (the DataGrid's current cell): the ring's colour, and no inner rule. -->
    <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="AppFocusRingBrush" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />

    <!--
        Body text size: 13, the macOS system size, for everything Fluent sizes from
        this key (every Window, and every control that does not set its own). Fluent's
        14 made a list, a tree or a form read a size larger than any native app beside
        it. Text that sets its own FontSize is unaffected.
    -->
    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

    <!--
        Typography (DESIGN.md rule 22). These are the defaults; each app replaces all
        four from its settings through Nimbus.Ui.Fonts.NimbusFonts.Apply, which writes
        the application's own resources, so nothing here needs editing to change a face.
        The interface face is Fluent's ContentControlThemeFontFamily, left at Fluent's
        Inter here.

        MonoFont: code, values and identifiers, through the `mono` class in Theme.axaml.
        The bundled JetBrains Mono NL, so a frame drawn in a CI container (which has no
        Cascadia, Consolas or Menlo) shows the same face as one drawn on a desktop.

        KeyCapFont: text that spells a shortcut (rule 4). The interface face first, then
        faces that carry Apple's key glyphs at text size.

        InterfaceLetterSpacing: 0, except for San Francisco on macOS (NimbusFonts).
    -->
    <FontFamily x:Key="MonoFont">fonts:JetBrainsMono#JetBrains Mono NL</FontFamily>
    <FontFamily x:Key="KeyCapFont">fonts:Inter#Inter, Lucida Grande, Segoe UI Symbol</FontFamily>
    <x:Double x:Key="InterfaceLetterSpacing">0</x:Double>

    <!--
        ToggleSwitch, Apple-style (DESIGN.md rule 20): a filled track with no outline,
        a white knob in both states, the accent track when on. The off track is
        theme-split and lives in the theme dictionaries above; the geometry (32x18,
        14px knob) is in Controls.axaml.
    -->
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent" />
    <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">0</Thickness>
    <Thickness x:Key="ToggleSwitchOnStrokeThickness">0</Thickness>
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AppAccentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AppAccentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AppAccentPressedBrush" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#662D7FF9" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />

    <!--
        Destructive action (drop a schema, delete a resource, terminate a session) and
        the error status colour. A fixed red we control, legible on both themes: the
        solid brush for a filled primary-destructive button (`Button.danger`, mirroring
        `.accent`), hover/pressed shades for it, and a low-alpha wash + border for the
        soft/outline variant.

        One value, one name. kubeNimbus reached this repo with `ErrorBrush` set to the
        CSS named colour `IndianRed` while pgNimbus used `#E5484D` for the same job —
        the exact drift a shared token file exists to make impossible.
    -->
    <SolidColorBrush x:Key="AppDangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#EC5B60" />
    <SolidColorBrush x:Key="AppDangerPressedBrush" Color="#CE3B40" />
    <SolidColorBrush x:Key="AppDangerWashBrush" Color="#22E5484D" />
    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#66E5484D" />

    <!--
        Attention, not danger: a row worth spotting (a backend stuck on a lock, a pod
        that is Pending) and the warn status text. One fixed amber for all of them —
        dark enough to stay legible on a white grid row, warm enough to read as amber on
        dark. Deliberately a token: hand-rolled #E5A50A/#D9822B literals had already
        drifted apart between two windows of one app before this existed.
    -->
    <SolidColorBrush x:Key="AppWarningBrush" Color="#D9822B" />

    <!-- Healthy/running/connected. The third of the status trio; pairs with the two
         above so a status dot, a pill and a text run all agree. -->
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#46A758" />

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- Fixed-alpha neutral grey so cards read the same, subtle weight in light and dark. -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#80808080" Opacity="0.06" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#80808080" Opacity="0.16" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#80808080" Opacity="0.1" />

    <!--
        Nav pill highlight. FluentTheme's TabItem ControlTheme repaints PART_LayoutRoot's
        background from these TabItemHeaderBackground* resources on :pointerover/:pressed
        (transparent by default), which erases any background set on the TabItem itself
        as soon as the pointer touches the selected tab. Those inner ControlTheme styles
        also win the precedence fight against app-level /template/ styles, so the
        reliable override point is the DynamicResource values they paint with. This
        dictionary is merged by a Styles file that loads after FluentTheme, so these take
        priority in resource lookup.
    -->
    <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="AppSelectionBrush" />
    <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="AppSelectionBrush" />
    <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="AppSelectionBrush" />
    <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="HoverBackgroundBrush" />
    <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPressed" ResourceKey="HoverBackgroundBrush" />
    <!-- The pill *is* the selection indicator — hide the stock underline pipe. -->
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />

    <!--
        DataGrid row selection. The DataGrid Fluent theme paints a selected row's backing
        rectangle Fill from these DynamicResource brushes (SystemAccentColor by default —
        the one selection surface a fixed-brand-blue pass tends to miss, which is why grid
        rows could read grey while everything else selected blue) with a separate Opacity
        resource per state. Brush = opaque brand accent, opacity tuned so the resulting
        wash matches AppSelectionBrush (0x28 alpha ≈ 0.157), hover a touch stronger.
        Unfocused states stay identical to focused ones — no other selection surface in
        either app dims on focus loss.
    -->
    <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="AppAccentBrush" />
    <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="AppAccentBrush" />
    <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="AppAccentBrush" />
    <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="AppAccentBrush" />
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.157</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.235</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.157</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.235</x:Double>

    <!-- Slim 10px thumb-only overlay scrollbars, app-wide. -->
    <x:Double x:Key="ScrollBarSize">10</x:Double>
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
    <Color x:Key="ScrollBarThumbBackgroundColor">#66808080</Color>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99808080" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B3808080" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#66808080" />
    <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="Transparent" />
    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.3) translateX(-2px)</TransformOperations>
    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.3) translateY(-2px)</TransformOperations>

</ResourceDictionary>
